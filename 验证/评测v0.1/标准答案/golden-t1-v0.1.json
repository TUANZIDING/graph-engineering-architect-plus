{
 "schema_version": "1.1",
 "title": "睡眠起始检测竞赛：自动迭代到一次最终上传",
 "mode": "graph_plus_loop",
 "state": "awaiting_approval",
 "root_goal": {
  "statement": "在隐藏测试集上取得稳健的最终成绩",
  "human_owner": "Bruce",
  "observable_success": "冻结留出折上的成绩与公开榜方向一致且波动在预设范围内，Bruce 选定唯一最终上传",
  "metrics": [
   "holdout_score"
  ]
 },
 "external_inputs": [
  "holdout-split",
  "train-folds",
  "public-lb-receipt",
  "graph-spec",
  "run-status"
 ],
 "permissions": {
  "human_owner": "Bruce",
  "allowed_actions": [
   "本地训练与融合",
   "每日公开榜提交（不超过 5 次）"
  ],
  "forbidden_actions": [
   "最终阶段上传（只允许一次，须 Bruce 决定）",
   "修改留出折划分"
  ]
 },
 "frozen_rules": [
  "留出折划分冻结，调参回路不可读取其标签",
  "公开榜每日 5 次配额，用尽即停"
 ],
 "approval": {
  "status": "pending",
  "record": "等待 Bruce 确认 Graph"
 },
 "budget": {
  "max_agents": 5,
  "max_concurrency": 2,
  "max_retries": 1,
  "max_cost_units": 30
 },
 "failure_policy": {
  "on_validation_failure": "stop_and_handoff",
  "on_budget_exhausted": "handoff_to_human"
 },
 "stop_handoff": {
  "owner": "Bruce",
  "conditions": [
   "配额用尽",
   "留出与公开榜背离",
   "预算耗尽",
   "锚点过期"
  ],
  "artifact": "handoff-record"
 },
 "execution_contract": {
  "external_execution": false
 },
 "anchors": [
  {
   "node_id": "holdout",
   "source": "冻结的本地留出折（按受试者划分，调参回路看不到标签）+ 公开榜回执",
   "evidence_form": "留出折哈希与评分脚本",
   "owner": "Bruce",
   "freshness_rule": "每次运行前核对；超过 max_age_days 需重新确认",
   "max_age_days": 30,
   "last_confirmed": "2026-11-10",
   "frozen": true
  }
 ],
 "nodes": [
  {
   "id": "approval",
   "kind": "human_gate",
   "responsibility": "确认目标、锚点、权限与图",
   "owner": "Bruce",
   "contract": {
    "inputs": [
     "graph-spec"
    ],
    "outputs": [
     "approval-record"
    ]
   }
  },
  {
   "id": "holdout",
   "kind": "anchor",
   "responsibility": "保存调参看不到的留出折与评分脚本",
   "owner": "Bruce",
   "contract": {
    "inputs": [
     "holdout-split"
    ],
    "outputs": [
     "holdout-labels"
    ]
   }
  },
  {
   "id": "tune",
   "kind": "execution_loop",
   "responsibility": "调参、特征与融合，只用训练折交叉验证",
   "owner": "调参 Agent",
   "contract": {
    "inputs": [
     "approval-record",
     "train-folds"
    ],
    "outputs": [
     "candidate-model"
    ]
   },
   "optimizes": "holdout_score",
   "max_iterations": 5,
   "evidence_sources": [
    "train-folds"
   ],
   "writes": [
    "models/"
   ]
  },
  {
   "id": "holdout-eval",
   "kind": "verification_loop",
   "responsibility": "用留出折独立评分候选模型",
   "owner": "评分脚本",
   "contract": {
    "inputs": [
     "candidate-model",
     "holdout-labels"
    ],
    "outputs": [
     "holdout-report"
    ]
   },
   "context_scope": "fresh-independent",
   "max_iterations": 1,
   "evidence_sources": [
    "holdout-labels"
   ]
  },
  {
   "id": "overfit-watch",
   "kind": "counter_metric_loop",
   "responsibility": "盯住公开榜与留出折的差距、方差和过拟合迹象",
   "owner": "反指标审查",
   "contract": {
    "inputs": [
     "holdout-report",
     "public-lb-receipt"
    ],
    "outputs": [
     "overfit-report"
    ]
   },
   "max_iterations": 1,
   "evidence_sources": [
    "public-lb-receipt"
   ]
  },
  {
   "id": "arbiter",
   "kind": "arbitration",
   "responsibility": "留出折与公开榜冲突时裁决",
   "owner": "Bruce",
   "contract": {
    "inputs": [
     "holdout-report",
     "overfit-report"
    ],
    "outputs": [
     "shortlist"
    ]
   },
   "priority_policy": "留出折稳健性 > 公开榜名次"
  },
  {
   "id": "final-gate",
   "kind": "human_gate",
   "responsibility": "Bruce 决定唯一一次最终上传",
   "owner": "Bruce",
   "contract": {
    "inputs": [
     "shortlist"
    ],
    "outputs": [
     "upload-decision"
    ]
   },
   "side_effect": "high-risk"
  },
  {
   "id": "stop",
   "kind": "stop_handoff",
   "responsibility": "收束或失败时交接",
   "owner": "Bruce",
   "contract": {
    "inputs": [
     "run-status"
    ],
    "outputs": [
     "handoff-record"
    ]
   }
  }
 ],
 "edges": [
  {
   "from": "approval",
   "to": "tune",
   "relation": "constrains",
   "artifact": "approval-record"
  },
  {
   "from": "approval",
   "to": "holdout",
   "relation": "constrains",
   "artifact": "approval-record"
  },
  {
   "from": "holdout",
   "to": "holdout-eval",
   "relation": "anchors",
   "artifact": "holdout-labels"
  },
  {
   "from": "tune",
   "to": "holdout-eval",
   "relation": "feeds",
   "artifact": "candidate-model"
  },
  {
   "from": "holdout-eval",
   "to": "overfit-watch",
   "relation": "feeds",
   "artifact": "holdout-report"
  },
  {
   "from": "overfit-watch",
   "to": "tune",
   "relation": "observes",
   "artifact": "overfit-report"
  },
  {
   "from": "holdout-eval",
   "to": "arbiter",
   "relation": "escalates",
   "artifact": "holdout-report"
  },
  {
   "from": "overfit-watch",
   "to": "arbiter",
   "relation": "escalates",
   "artifact": "overfit-report"
  },
  {
   "from": "arbiter",
   "to": "final-gate",
   "relation": "constrains",
   "artifact": "shortlist"
  },
  {
   "from": "holdout-eval",
   "to": "final-gate",
   "relation": "vetoes",
   "artifact": "holdout-report"
  },
  {
   "from": "final-gate",
   "to": "stop",
   "relation": "hands_off",
   "artifact": "upload-decision"
  }
 ]
}