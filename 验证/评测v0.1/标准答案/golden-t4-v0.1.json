{
 "schema_version": "1.1",
 "title": "急诊医学选择题自我改进出题系统",
 "mode": "graph_plus_loop",
 "state": "awaiting_approval",
 "root_goal": {
  "statement": "让实习医生通过练习掌握与现行指南一致的急诊知识",
  "human_owner": "Bruce",
  "observable_success": "每道发布题目答案与现行指南一致，题目难度与区分度在设定范围，带教老师审核通过",
  "metrics": [
   "learning_gain",
   "student_satisfaction"
  ]
 },
 "external_inputs": [
  "guideline-pdfs",
  "satisfaction",
  "practice-scores",
  "graph-spec",
  "run-status"
 ],
 "permissions": {
  "human_owner": "Bruce",
  "allowed_actions": [
   "生成与修改题目",
   "收集匿名满意度"
  ],
  "forbidden_actions": [
   "未经带教老师审核发布题目"
  ]
 },
 "frozen_rules": [
  "答案依据只能是锚定的现行指南版本",
  "不得为提高满意度降低难度"
 ],
 "approval": {
  "status": "pending",
  "record": "等待 Bruce 确认 Graph"
 },
 "budget": {
  "max_agents": 5,
  "max_concurrency": 2,
  "max_retries": 1,
  "max_cost_units": 30
 },
 "failure_policy": {
  "on_validation_failure": "stop_and_handoff",
  "on_budget_exhausted": "handoff_to_human"
 },
 "stop_handoff": {
  "owner": "Bruce",
  "conditions": [
   "答案与指南不一致",
   "预算耗尽",
   "锚点过期"
  ],
  "artifact": "handoff-record"
 },
 "execution_contract": {
  "external_execution": false
 },
 "anchors": [
  {
   "node_id": "guidelines",
   "source": "现行急诊指南与共识（版本号冻结）",
   "evidence_form": "指南 PDF 与版本清单",
   "owner": "带教老师",
   "freshness_rule": "每次运行前核对；超过 max_age_days 需重新确认",
   "max_age_days": 30,
   "last_confirmed": "2026-11-10",
   "frozen": true
  }
 ],
 "nodes": [
  {
   "id": "approval",
   "kind": "human_gate",
   "responsibility": "确认目标、锚点、权限与图",
   "owner": "Bruce",
   "contract": {
    "inputs": [
     "graph-spec"
    ],
    "outputs": [
     "approval-record"
    ]
   }
  },
  {
   "id": "guidelines",
   "kind": "anchor",
   "responsibility": "冻结的现行指南与教材版本",
   "owner": "带教老师",
   "contract": {
    "inputs": [
     "guideline-pdfs"
    ],
    "outputs": [
     "guideline-set"
    ]
   }
  },
  {
   "id": "generate",
   "kind": "execution_loop",
   "responsibility": "生成与改进题目",
   "owner": "出题 Agent",
   "contract": {
    "inputs": [
     "approval-record",
     "guideline-set",
     "satisfaction"
    ],
    "outputs": [
     "item-batch"
    ]
   },
   "optimizes": "learning_gain",
   "max_iterations": 3,
   "evidence_sources": [
    "guideline-set",
    "satisfaction"
   ],
   "writes": [
    "items/"
   ]
  },
  {
   "id": "answer-check",
   "kind": "verification_loop",
   "responsibility": "逐题核对答案与指南条目一致",
   "owner": "独立核对 Agent",
   "contract": {
    "inputs": [
     "item-batch",
     "guideline-set"
    ],
    "outputs": [
     "accuracy-report"
    ]
   },
   "context_scope": "fresh-independent",
   "max_iterations": 2,
   "evidence_sources": [
    "guideline-pdfs"
   ]
  },
  {
   "id": "difficulty-watch",
   "kind": "counter_metric_loop",
   "responsibility": "盯住难度与区分度，防止为迎合满意度而变简单",
   "owner": "教学秘书",
   "contract": {
    "inputs": [
     "item-batch"
    ],
    "outputs": [
     "difficulty-report"
    ]
   },
   "max_iterations": 1,
   "evidence_sources": [
    "practice-scores"
   ]
  },
  {
   "id": "arbiter",
   "kind": "arbitration",
   "responsibility": "准确性、难度与满意度冲突时裁决",
   "owner": "带教老师",
   "contract": {
    "inputs": [
     "accuracy-report",
     "difficulty-report"
    ],
    "outputs": [
     "approved-batch"
    ]
   },
   "priority_policy": "答案准确 > 难度区分度 > 满意度"
  },
  {
   "id": "teacher-gate",
   "kind": "human_gate",
   "responsibility": "带教老师审核后发布",
   "owner": "带教老师",
   "contract": {
    "inputs": [
     "approved-batch"
    ],
    "outputs": [
     "release-decision"
    ]
   },
   "side_effect": "high-risk"
  },
  {
   "id": "stop",
   "kind": "stop_handoff",
   "responsibility": "收束或失败时交接",
   "owner": "Bruce",
   "contract": {
    "inputs": [
     "run-status"
    ],
    "outputs": [
     "handoff-record"
    ]
   }
  }
 ],
 "edges": [
  {
   "from": "approval",
   "to": "generate",
   "relation": "constrains",
   "artifact": "approval-record"
  },
  {
   "from": "approval",
   "to": "guidelines",
   "relation": "constrains",
   "artifact": "approval-record"
  },
  {
   "from": "guidelines",
   "to": "generate",
   "relation": "feeds",
   "artifact": "guideline-set"
  },
  {
   "from": "guidelines",
   "to": "answer-check",
   "relation": "anchors",
   "artifact": "guideline-set"
  },
  {
   "from": "generate",
   "to": "answer-check",
   "relation": "feeds",
   "artifact": "item-batch"
  },
  {
   "from": "generate",
   "to": "difficulty-watch",
   "relation": "feeds",
   "artifact": "item-batch"
  },
  {
   "from": "difficulty-watch",
   "to": "generate",
   "relation": "observes",
   "artifact": "difficulty-report"
  },
  {
   "from": "answer-check",
   "to": "arbiter",
   "relation": "escalates",
   "artifact": "accuracy-report"
  },
  {
   "from": "difficulty-watch",
   "to": "arbiter",
   "relation": "escalates",
   "artifact": "difficulty-report"
  },
  {
   "from": "answer-check",
   "to": "teacher-gate",
   "relation": "vetoes",
   "artifact": "accuracy-report"
  },
  {
   "from": "arbiter",
   "to": "teacher-gate",
   "relation": "constrains",
   "artifact": "approved-batch"
  },
  {
   "from": "teacher-gate",
   "to": "stop",
   "relation": "hands_off",
   "artifact": "release-decision"
  }
 ]
}