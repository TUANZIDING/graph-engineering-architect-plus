{
  "schema_version": "1.1",
  "title": "急诊 AI 休克预警阈值持续优化控制图",
  "mode": "graph_plus_loop",
  "state": "designed",
  "root_goal": {
    "statement": "在报警负担不超过护理可承受上限的前提下，降低急诊休克漏诊（提高经独立判读确认的真实敏感度），且每次阈值上线均经科室医疗质量委员会批准",
    "human_owner": "Bruce",
    "observable_success": "相对现行阈值：在时间外推留出集与上线后前瞻性病例判读中，休克敏感度提高且 95%CI 下限不低于基线；每护士班次报警数、PPV、护士报警忽略/静音率不劣于委员会设定上限；漏诊病例复盘数下降；上线有委员会签字记录且可回滚",
    "out_of_scope": [
      "Agent 自动上线或修改生产阈值",
      "Agent 修改休克结局定义、判读标准、留出集或报警负担上限",
      "修改预警模型本身的结构或重新训练（另立项目）",
      "对个别患者给出临床处置决定"
    ],
    "metrics": [
      "独立判读的休克敏感度",
      "每护士班次报警数",
      "报警 PPV",
      "护士忽略/静音率",
      "漏诊病例数"
    ]
  },
  "classification_rationale": "单回路不够：Agent 优化的敏感度与护士报警负担直接冲突（降阈值即可刷敏感度、同时制造报警疲劳，疲劳反过来导致报警被忽略、实际漏诊上升）；需要独立于调参者的结局判读锚点、反指标回路、月度来源/漂移审计、仲裁优先级，以及委员会人工门后才能产生高风险上线副作用。故为图 + 调参执行回路。",
  "permissions": {
    "human_owner": "Bruce",
    "allowed_actions": [
      "读取脱敏的历史预警分数与开发集结局",
      "在开发集上搜索候选阈值并生成候选报告",
      "提交候选阈值给验证与反指标节点",
      "提议修改目标、上限或锚点（仅提议）"
    ],
    "forbidden_actions": [
      "写入生产报警配置",
      "读取或使用时间外推留出集与判读结局做调参",
      "修改休克结局定义、判读表单、报警负担上限",
      "绕过医疗质量委员会上线",
      "修改验证/审计脚本或其通过标准"
    ]
  },
  "frozen_rules": [
    "休克结局定义与临床医师盲法判读标准冻结，变更须委员会批准",
    "时间外推留出集冻结，调参回路不可访问",
    "报警负担硬上限（每护士班次报警数、最低 PPV、忽略率上限）由委员会设定，Agent 不可改",
    "敏感度不得低于现行阈值基线（安全底线）",
    "任何生产阈值变更必须经医疗质量委员会签字，并保留一键回滚到上一版阈值",
    "验证与审计脚本、通过标准由调参者以外的人维护"
  ],
  "approval": {
    "status": "pending"
  },
  "budget": {
    "max_agents": 6,
    "max_concurrency": 2,
    "max_retries": 2,
    "max_cost_units": 20
  },
  "failure_policy": {
    "failed": "候选被验证或反指标否决：记录原因，退回调参回路，本周期最多重试 2 次；仍失败则本周期维持现行阈值并交接",
    "blocked": "锚点过期、判读结局不足或数据管道漂移：停止产出候选，升级给 Bruce 与审计负责人",
    "budget_exhausted": "停止本周期，维持现行阈值，提交已有证据与未决问题给 Bruce"
  },
  "stop_handoff": {
    "owner": "Bruce",
    "conditions": [
      "completed: 委员会批准的阈值上线且上线后 4 周监测达标",
      "failed: 连续两个周期无候选同时满足敏感度与报警负担约束",
      "blocked: 锚点过期/数据漂移未解决，或上线后监测触发回滚",
      "budget_exhausted: 本周期重试或成本预算用尽"
    ],
    "artifact": "handoff.md（候选、验证与反指标报告、委员会决议、监测结果、回滚记录）"
  },
  "execution_contract": {
    "external_execution": false
  },
  "governance": {
    "arbitration": {
      "owner": "急诊科医疗质量委员会主任（Bruce 提交）",
      "priority_policy": "1) 敏感度不低于基线（安全底线）与报警负担硬上限均为否决条件，任一违反即否；2) 两者都满足时，优先选减少漏诊更多者；3) 敏感度增益与负担增加需权衡时，按委员会预设的‘每多发现1例休克可接受的额外报警数’交换比裁决；4) 证据不足维持现行阈值"
    },
    "goal_change": "human_approval",
    "approval_required": [
      "Root-goal change",
      "Anchor change",
      "Permission expansion",
      "报警负担上限变更",
      "生产阈值上线"
    ]
  },
  "verification": {
    "independence_statement": "验证者由临床信息科维护，评估脚本独立于调参 Agent；数据来源为时间外推留出集与临床医师盲法判读的休克结局（来自病历/乳酸/血管活性药/转归），而非调参者使用的开发集或报警日志；反指标数据来自护理报警日志与护士反馈，调参者无法写入。",
    "checks": [
      "verifier",
      "counter_alarm_burden"
    ]
  },
  "external_inputs": [
