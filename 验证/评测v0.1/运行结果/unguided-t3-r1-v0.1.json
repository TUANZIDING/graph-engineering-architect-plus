    {"from": "independent_verifier", "to": "stop_handoff_bruce", "relation": "escalates", "artifact": "独立验证报告"},
    {"from": "alarm_burden_counter", "to": "stop_handoff_bruce", "relation": "escalates", "artifact": "报警负担评估与否决意见"},
