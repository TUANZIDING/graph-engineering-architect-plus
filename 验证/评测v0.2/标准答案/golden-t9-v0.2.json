{
 "schema_version": "1.1",
 "title": "胸痛分诊助手提示词优化",
 "mode": "graph_plus_loop",
 "state": "awaiting_approval",
 "root_goal": {
  "statement": "让分诊助手安全地识别高危胸痛",
  "human_owner": "Bruce",
  "observable_success": "以最终诊断和 30 天结局为准，高危胸痛低估分级率不升高；三年前的标准经心内与急诊复审更新后才作参照；Bruce 批准上线预检台",
  "metrics": [
   "undertriage_rate",
   "standard_agreement"
  ]
 },
 "external_inputs": [
  "chart-review",
  "old-standard",
  "current-guidelines",
  "replay-log",
  "graph-spec",
  "run-status"
 ],
 "permissions": {
  "human_owner": "Bruce",
  "allowed_actions": [
   "离线改写提示词并回放历史病例"
  ],
  "forbidden_actions": [
   "未经批准在预检台启用",
   "修改结局标注或参照标准"
  ]
 },
 "frozen_rules": [
  "参照标准须先按现行指南复审，复审前不作金标准",
  "上线预检台须 Bruce 批准"
 ],
 "approval": {
  "status": "pending",
  "record": "等待 Bruce 确认 Graph"
 },
 "budget": {
  "max_agents": 5,
  "max_concurrency": 2,
  "max_retries": 1,
  "max_cost_units": 30
 },
 "failure_policy": {
  "on_validation_failure": "stop_and_handoff",
  "on_budget_exhausted": "handoff_to_human"
 },
 "stop_handoff": {
  "owner": "Bruce",
  "conditions": [
   "低估分级上升",
   "标准未复审",
   "预算耗尽",
   "锚点过期"
  ],
  "artifact": "handoff-record"
 },
 "execution_contract": {
  "external_execution": false
 },
 "anchors": [
  {
   "node_id": "outcomes",
   "source": "历史胸痛病例的最终诊断与 30 天结局（ACS、肌钙蛋白、造影）",
   "evidence_form": "结局表",
   "owner": "复核小组",
   "freshness_rule": "每次运行前核对；超过 max_age_days 需重新确认",
   "max_age_days": 30,
   "last_confirmed": "2026-11-10",
   "frozen": true
  }
 ],
 "nodes": [
  {
   "id": "approval",
   "kind": "human_gate",
   "responsibility": "确认目标、锚点、权限与图",
   "owner": "Bruce",
   "contract": {
    "inputs": [
     "graph-spec"
    ],
    "outputs": [
     "approval-record"
    ]
   }
  },
  {
   "id": "outcomes",
   "kind": "anchor",
   "responsibility": "冻结的最终诊断与 30 天结局",
   "owner": "复核小组",
   "contract": {
    "inputs": [
     "chart-review"
    ],
    "outputs": [
     "outcome-set"
    ]
   }
  },
  {
   "id": "standard-review",
   "kind": "governance_loop",
   "responsibility": "心内与急诊按现行指南复审三年前的分诊标准，过时条目先更新",
   "owner": "科室质控小组",
   "contract": {
    "inputs": [
     "old-standard",
     "current-guidelines"
    ],
    "outputs": [
     "reviewed-standard"
    ]
   },
   "cadence_tier": "slow"
  },
  {
   "id": "prompt-opt",
   "kind": "execution_loop",
   "responsibility": "改写分诊提示词",
   "owner": "提示词 Agent",
   "contract": {
    "inputs": [
     "approval-record",
     "reviewed-standard"
    ],
    "outputs": [
     "prompt-candidate"
    ]
   },
   "optimizes": "standard_agreement",
   "max_iterations": 4,
   "evidence_sources": [
    "reviewed-standard"
   ],
   "writes": [
    "prompts/"
   ]
  },
  {
   "id": "outcome-check",
   "kind": "verification_loop",
   "responsibility": "用真实结局回放评估分级",
   "owner": "评估脚本",
   "contract": {
    "inputs": [
     "prompt-candidate",
     "outcome-set"
    ],
    "outputs": [
     "outcome-report"
    ]
   },
   "context_scope": "fresh-independent",
   "max_iterations": 1,
   "evidence_sources": [
    "outcome-set"
   ]
  },
  {
   "id": "undertriage-watch",
   "kind": "counter_metric_loop",
   "responsibility": "监测高危胸痛被低估分级（漏诊）",
   "owner": "急诊质控",
   "contract": {
    "inputs": [
     "prompt-candidate"
    ],
    "outputs": [
     "undertriage-report"
    ]
   },
   "max_iterations": 1,
   "evidence_sources": [
    "replay-log"
   ]
  },
  {
   "id": "arbiter",
   "kind": "arbitration",
   "responsibility": "一致率与漏诊冲突时裁决",
   "owner": "急诊科主任",
   "contract": {
    "inputs": [
     "outcome-report",
     "undertriage-report"
    ],
    "outputs": [
     "recommendation"
    ]
   },
   "priority_policy": "不增加低估分级 > 结局一致 > 标准一致率"
  },
  {
   "id": "deploy-gate",
   "kind": "human_gate",
   "responsibility": "Bruce 批准在预检台上线",
   "owner": "Bruce",
   "contract": {
    "inputs": [
     "recommendation"
    ],
    "outputs": [
     "deploy-decision"
    ]
   },
   "side_effect": "high-risk"
  },
  {
   "id": "stop",
   "kind": "stop_handoff",
   "responsibility": "收束或失败时交接",
   "owner": "Bruce",
   "contract": {
    "inputs": [
     "run-status"
    ],
    "outputs": [
     "handoff-record"
    ]
   }
  }
 ],
 "edges": [
  {
