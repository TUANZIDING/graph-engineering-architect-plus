{
 "schema_version": "1.1",
 "title": "急诊出院流程双目标改进控制架构",
 "mode": "graph",
 "state": "designed",
 "classification_rationale": "两个 Agent 优化相互拉扯的目标（滞留时间 vs 72h 返诊），且共享同一可写对象（出院标准与流程清单）；两个指标都可被钻空子（提早赶人出院/把患者推去别院或收住院），需要独立验证、反指标、仲裁、单写者与人工门，属于 graph。",
 "root_goal": {
  "statement": "在不增加患者伤害的前提下，同时缩短急诊滞留时间并降低 72 小时返诊率，改进急诊出院标准与流程清单。",
  "human_owner": "Bruce",
  "observable_success": "相对冻结基线（前 12 周 HIS 原始就诊数据），连续 8 周：急诊滞留时间中位数下降 ≥10%；72h 返诊率（含区域平台跨院返诊）不升且目标下降 ≥10%；72h 返诊后收住院/ICU/死亡、离院未就诊率、出院医嘱不全率均不劣于基线（非劣效界值由质控委员会冻结）；改动均经急诊质控委员会批准。",
  "metrics": [
   "ed_length_of_stay",
   "return_72h_rate",
   "return_72h_with_admission_icu_death",
   "lwbs_rate",
   "cross_hospital_return_rate",
   "boarding_time"
  ],
  "out_of_scope": [
   "Agent 直接修改生产 HIS 出院标准或医嘱",
   "单个患者的临床处置决策",
   "改变诊断编码、返诊定义或统计口径",
   "绩效考核与人员处罚"
  ]
 },
 "permissions": {
  "human_owner": "Bruce",
  "allowed_actions": [
   "读取脱敏 HIS 就诊数据与分析结果",
   "提出出院标准/流程清单修改提案",
   "在沙盒中做回顾性模拟评估",
   "生成报告与升级请求"
  ],
  "forbidden_actions": [
   "直接写入生产出院标准或流程清单",
   "修改返诊/滞留时间定义、基线或非劣效界值",
   "修改验证器、反指标、审计脚本或锚点数据",
   "绕过质控委员会人工门上线改动",
   "接触可识别患者身份信息"
  ]
 },
 "frozen_rules": [
  "滞留时间=到达分诊至离开急诊的 HIS 原始时间戳差；72h 返诊=任一出院后 72h 内同一患者在本院或区域平台任一医院的非计划急诊就诊；口径冻结，改动需 Bruce 与质控委员会批准",
  "基线期、非劣效界值与安全反指标清单冻结",
  "两个执行 Agent 只能产出提案，生产出院标准与清单仅由人工门批准后单一写者发布",
  "冲突优先级：患者安全反指标 > 72h 返诊率 > 急诊滞留时间",
  "每次上线后最短观察窗 4 周，期间不得叠加新的同类改动",
  "Agent 不得修改验证者、审计、锚点或治理规则，只能提议"
 ],
 "approval": {
  "status": "pending"
 },
 "budget": {
  "max_agents": 8,
  "max_concurrency": 3,
  "max_retries": 2,
  "max_cost_units": 200
 },
 "failure_policy": {
  "failed": "安全反指标越界或验证否决：提案作废；已上线改动由发布节点回滚并升级 Bruce",
  "blocked": "锚点过期、数据管道异常或口径争议：暂停所有提案直至审计确认并由 Bruce 裁定",
  "budget_exhausted": "迭代或成本预算耗尽：冻结当前生产版本，交接 Bruce",
  "stalled": "连续 3 轮无提案通过验证：停止并交接 Bruce 复审目标"
 },
 "stop_handoff": {
  "owner": "Bruce",
  "conditions": [
   "completed: 达成 observable_success 且审计确认锚点新鲜",
   "blocked: 锚点数据不可得或口径争议未决",
   "failed: 安全反指标越界且回滚",
   "budget_exhausted: 迭代或成本预算耗尽",
   "stalled: 连续 3 轮无提案通过验证"
  ],
  "artifact": "终态交接报告（指标对比、上线改动清单、回滚记录、未决冲突）"
 },
 "execution_contract": {
  "external_execution": false
 },
 "external_inputs": [
  "HIS 原始就诊时间戳",
  "区域健康信息平台返诊记录",
  "医师病历抽查结果"
