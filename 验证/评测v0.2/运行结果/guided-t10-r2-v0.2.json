{
  "schema_version": "1.1",
  "title": "急诊出院流程双目标改进控制架构（滞留时间 × 72小时返诊）",
  "mode": "graph",
  "state": "designed",
  "root_goal": {
    "statement": "在不增加患者安全风险的前提下改进急诊出院流程：缩短急诊滞留时间（ED LOS），同时降低72小时非计划返诊率；两者共享同一份出院标准与流程清单，任何改动必须经独立验证、反指标检查与人工批准后才能上线。",
    "human_owner": "Bruce",
    "observable_success": "试点期（≥8周）相对基线：出院患者ED LOS中位数下降且72小时非计划返诊率（含外院返诊，经区域平台核对）不升高或下降；7天内死亡/ICU收治、返诊收住院率、离院未就诊率、医嘱外留观率均未超出预设安全阈值；结果由独立质控按原始HIS时间戳与区域健康平台复算一致，并经Bruce与急诊医疗质量委员会签字确认。",
    "out_of_scope": [
      "Agent直接修改生产HIS中的出院标准、医嘱或流程清单",
      "Agent对个体患者做出院决定或替代医生临床判断",
      "修改滞留时间、返诊的统计口径或基线数据",
      "调整人员排班、床位分配或绩效考核",
      "未经伦理/质控批准开展任何患者层面的前瞻性干预"
    ],
    "metrics": [
      "ED LOS中位数",
      "72小时非计划返诊率",
      "7天死亡或ICU收治率",
      "返诊收住院率",
      "入院率",
      "离院未就诊率"
    ]
  },
  "classification_rationale": "两个优化回路追求相互拉扯的目标（缩短滞留倾向于更早出院，降低返诊倾向于更晚出院或更多收住院），且都想写同一份出院标准与清单——存在单写者冲突、Goodhart风险（如把患者转入留观区停表、把返诊编码为计划复诊、用多收住院换低返诊）和高风险临床副作用。必须有独立于优化者的现实锚点、反指标、仲裁、慢速审计与人工门，单回路或线性流程无法提供这些约束。",
  "permissions": {
    "human_owner": "Bruce",
    "allowed_actions": [
      "读取脱敏后的急诊运营看板与历史出院数据",
      "生成出院标准与流程清单的修改提案（含理由与预期效应）",
      "对提案做回顾性模拟与亚组分析",
      "在批准的试点范围内收集指标并出具报告"
    ],
    "forbidden_actions": [
      "直接写入生产出院标准、流程清单或HIS配置",
      "修改指标口径、基线、锚点数据或验证阈值",
      "修改或屏蔽验证、反指标、审计节点的输入与结论",
      "两个执行Agent互相覆盖对方提案或绕过仲裁",
      "访问可识别患者身份的原始数据（脱敏流程之外）"
    ]
  },
  "frozen_rules": [
    "ED LOS定义（到达至离开急诊的HIS时间戳）与72小时非计划返诊定义（含外院、排除预约复诊）在本项目期间冻结，只能由Bruce经人工门修改",
    "安全底线：7天死亡/ICU收治率、返诊收住院率不得超过基线+预设阈值；触线即暂停试点",
    "出院标准与流程清单唯一写入者为人工门（急诊医疗质量委员会+Bruce），Agent只能提案",
    "优先级：患者安全 > 72小时返诊 > 滞留时间 > 流程便利",
    "锚点数据源（HIS原始时间戳、区域健康平台返诊记录、死亡登记）只读，优化回路不可写、不可筛选",
    "验证、反指标、审计节点的阈值与方法不得被执行回路修改"
  ],
  "approval": {
    "status": "pending"
  },
  "budget": {
    "max_agents": 8,
    "max_concurrency": 3,
    "max_retries": 2,
    "max_cost_units": 40
  },
  "failure_policy": {
    "failed": "验证或反指标否决、或试点触及安全底线：立即回滚到上一版已批准标准，写失败报告交Bruce",
    "blocked": "锚点数据过期/缺失或区域平台不可用：暂停所有提案评估，升级给Bruce与信息科，不得用派生看板替代",
    "budget_exhausted": "迭代或成本用尽仍无同时满足两目标的提案：停止，交付现有最佳提案与取舍分析由Bruce决定",
    "stalled": "两回路提案连续3轮相互抵消：交仲裁并升级至治理回路复审目标与阈值"
  },
  "stop_handoff": {
    "owner": "Bruce",
    "conditions": [
      "completed：试点结果经独立复算满足observable_success并获Bruce签字",
      "failed：安全底线被触发或验证否决不可修复，已回滚",
      "blocked：锚点不新鲜或不可得",
      "budget_exhausted：迭代/成本预算耗尽"
    ],
    "artifact": "handoff.md（已上线版本、证据包、未决冲突、回滚记录）"
  },
  "execution_contract": {
    "external_execution": false
