  "verification": {
    "independence_statement": "验证由质控科与独立统计脚本执行，评估者不同于两个优化 Agent；数据来源为 EHR 原始时间戳审计日志与区域健康信息平台返诊记录及病历抽样，而非 Agent 生成的报表；Agent 无写权限",
    "checks": [
      "verify_trial",
      "counter_harm",
      "audit_data"
    ]
  },
  "external_inputs": [
