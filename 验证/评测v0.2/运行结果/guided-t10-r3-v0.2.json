{
  "schema_version": "1.1",
  "title": "急诊出院流程双 Agent 改进控制图",
  "mode": "graph",
  "state": "designed",
  "root_goal": {
    "statement": "在不增加患者伤害的前提下，改进急诊出院流程：同时缩短急诊滞留时间（ED LOS）并降低 72 小时非计划返诊率",
    "human_owner": "Bruce",
    "observable_success": "试行期（≥8 周、与基线同季节对照）内：EHR 时间戳计算的出院患者 ED LOS 中位数下降，且经区域健康信息平台核对的 72 小时非计划返诊率（含院外返诊）不升高或下降；返诊后 ICU 入住/7 天内死亡等不良结局不增加；任何清单/标准变更均有医疗主任签字记录",
    "out_of_scope": [
      "Agent 直接修改生产 EHR 出院医嘱、出院标准或流程清单",
      "Agent 对单个患者做出院或留观临床决策",
      "通过改变返诊/滞留的统计口径、分诊编码或计时起止点来改善指标",
      "调整人员编制、排班或收治床位政策"
    ],
    "metrics": [
      "ED LOS 中位数",
      "72 小时非计划返诊率",
      "返诊不良结局率",
      "出院转住院率"
    ]
  },
  "classification_rationale": "两个优化回路作用于同一共享变量（出院标准与流程清单）且目标天然拉扯：放宽出院可缩短滞留但抬高返诊，收紧出院可降低返诊但延长滞留或把患者收入院。两个指标都可被刷（改计时口径、把患者转住院、返诊流向他院不被计数），涉及患者安全的高风险副作用，需要独立现实锚点、反指标、单写者变更控制、事前仲裁优先级和人工签字门，单回路或线性流程不够。",
  "permissions": {
    "human_owner": "Bruce",
    "allowed_actions": [
      "读取去标识化的急诊就诊、时间戳与返诊数据",
      "生成出院标准/流程清单的变更提案及预期影响分析",
      "在模拟或回顾性数据上评估提案"
    ],
    "forbidden_actions": [
      "直接写入生产出院标准或流程清单",
      "修改指标定义、计时起止点、返诊口径或锚点数据",
      "修改验证、反指标、审计节点的阈值或规则",
      "绕过医疗主任签字上线任何变更",
      "对个体患者给出出院决定"
    ]
  },
  "frozen_rules": [
    "ED LOS 定义：EHR 分诊登记时间至离开急诊时间，口径冻结",
    "72 小时非计划返诊定义：出院后 72 小时内任一医疗机构（经区域健康信息平台）非预约急诊就诊，口径冻结",
    "安全底线：返诊不良结局（ICU 入住、7 天内死亡、漏诊重大疾病）不得高于基线上界，越界即回滚",
    "优先级：患者安全 > 72 小时返诊 > ED LOS",
    "出院标准与流程清单只有部署节点一个写者，且只能凭医疗主任/Bruce 签字批准单写入",
    "Agent 不得改写验证、反指标、审计和锚点的规则"
  ],
  "approval": {
    "status": "pending"
  },
  "budget": {
    "max_agents": 8,
    "max_concurrency": 3,
    "max_retries": 2,
    "max_cost_units": 40
  },
  "failure_policy": {
    "failed": "安全底线越界或验证否决：回滚到上一签字版本清单，升级给 Bruce 与质控科",
    "blocked": "锚点过期或区域返诊数据不可得：冻结所有变更提案，停在当前签字版本，通知 Bruce",
    "budget_exhausted": "停止迭代，交付已验证提案与未决冲突清单给 Bruce"
  },
  "stop_handoff": {
    "owner": "Bruce",
    "conditions": [
      "completed: 试行期两项指标达到 observable_success 且安全底线未越界、锚点新鲜",
      "failed: 安全底线越界或连续两版提案被否决",
      "blocked: 锚点过期或独立返诊数据源中断",
      "budget_exhausted: 迭代次数或成本用尽"
    ],
    "artifact": "handoff.md（当前签字清单版本、试行指标与锚点对照、未决冲突、回滚记录）"
  },
  "execution_contract": {
    "external_execution": false
  },
  "governance": {
    "arbitration": {
      "owner": "Bruce",
      "priority_policy": "患者安全底线 > 72 小时返诊率 > ED LOS；两 Agent 提案冲突时，先保证返诊与不良结局不劣于基线，再在剩余空间内缩短滞留；无法兼得时升级 Bruce 决定"
    },
    "goal_change": "human_approval",
    "approval_required": [
      "Root-goal change",
      "Anchor change",
      "Permission expansion",
      "Frozen-rule change",
      "任何生产出院标准/清单上线"
