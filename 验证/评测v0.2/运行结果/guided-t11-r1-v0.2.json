   "cadence": "每批分歧",
   "cadence_tier": "medium",
   "priority_policy": "原文证据 > 预注册方案 > 合理性规则 > 双提取一致；任何来源定位缺失的单元格不得进入锁定表；冲突不可裁定时保留为不确定并做敏感性分析而非取平均",
   "evidence_sources": [
    "冻结原文副本"
   ],
   "side_effect": "internal-reversible",
   "writes": [
    "锁定提取表",
    "仲裁日志"
