     "冻结原文副本",
     "字段字典",
     "提取表A（独立提取完成后才解封用于比对）"
    ],
    "outputs": [
     "提取表B",
     "分歧清单",
     "否决记录"
    ]
   }
  },
  {
   "id": "plausibility_counter",
   "kind": "counter_metric_loop",
   "responsibility": "反指标：拆穿“一致率高但都错”。确定性检查 SE/SD 与 CI、n 的一致性、单位与效应方向、样本量合计、重复队列/重复发表、离群权重；高一致率但规则检查失败即否决",
   "owner": "确定性脚本",
   "cadence": "每版提取表",
   "cadence_tier": "medium",
   "max_iterations": 1,
   "context_scope": "fresh-independent",
   "evidence_sources": [
    "冻结原文副本",
    "预注册方案"
   ],
   "side_effect": "none",
   "writes": [
    "合理性检查报告"
   ],
   "contract": {
    "inputs": [
     "对账后提取表",
     "提取表A",
     "预注册方案",
     "冻结原文副本"
    ],
    "outputs": [
     "合理性检查报告"
    ]
   }
  },
