{
 "schema_version": "1.1",
 "title": "Meta 分析数据提取与合并分析复核控制图",
 "mode": "graph",
 "state": "designed",
 "classification_rationale": "原流程里 Agent B 只读 Agent A 的提取表重跑合并分析，两边一致只证明计算可复现，不证明提取正确（共享来源循环互证 / 看守剧场）。提取错误、效应方向错、SD/SE 混用、重复队列等都会被原样复制。需要独立回到原文的双人提取、可追溯锚点、反指标抽查、分歧仲裁和人工签字门，属于多回路相互约束，故用 graph。",
 "root_goal": {
  "statement": "论文中报告的合并效应量、置信区间和异质性，准确反映 40 篇纳入文献原文中的数据，并按预注册方案计算。",
  "human_owner": "Bruce",
  "observable_success": "每个提取单元格都有原文页码/表号定位并经独立双提取一致或经仲裁回原文裁定；人工随机抽查（≥10% 研究 + 全部权重前 5 的研究）与原文零关键差错；锁定提取表经确定性脚本合并的结果与论文数字逐项一致；Bruce 签字。",
  "metrics": [
   "原文抽查关键差错数",
   "双提取单元格一致率",
   "合并结果复现一致"
  ],
  "out_of_scope": [
   "文献检索与纳入/排除筛选",
   "偏倚风险评价",
   "论文讨论部分写作"
  ]
 },
 "permissions": {
  "human_owner": "Bruce",
  "allowed_actions": [
   "读取冻结的原文 PDF 副本",
   "写入各自的提取表",
   "运行锁定版本的合并分析脚本",
   "生成分歧清单与审计报告"
  ],
  "forbidden_actions": [
   "修改原文 PDF 或预注册方案",
   "Agent B 在独立提取阶段读取 Agent A 的提取表",
   "执行者修改核对规则、抽查规则或分析脚本",
   "未经 Bruce 签字把结果写入论文",
   "为提高一致率而删除或合并研究"
  ]
 },
 "frozen_rules": [
  "预注册方案（结局、效应量类型、模型、亚组）冻结，改动需 Bruce 批准并留记录",
  "40 篇原文 PDF 副本按哈希冻结",
  "提取字段字典与单位/方向约定冻结",
  "一致不等于正确：只有回到原文的独立提取或人工抽查才算复核",
  "合并分析脚本版本锁定"
 ],
 "approval": {
  "status": "pending"
 },
 "budget": {
  "max_agents": 6,
  "max_concurrency": 2,
  "max_retries": 2,
  "max_cost_units": 100
 },
 "failure_policy": {
  "failed": "人工抽查发现关键差错或合理性检查两轮仍失败 → 该批研究退回重新独立双提取；复算与论文数字不一致 → 阻断写入",
  "blocked": "原文缺关键数据或分歧两轮仲裁仍无法从原文确定 → 标记不确定，升级 Bruce 决定联系作者或做敏感性分析",
  "budget_exhausted": "重试或成本用尽 → 停止，交付当前锁定状态与未决清单给 Bruce"
 },
 "stop_handoff": {
  "owner": "Bruce",
  "conditions": [
   "completed: 全部检查通过且 Bruce 签字",
   "blocked: 原文缺数据无法提取且需联系作者",
   "failed: 抽查差错率超阈值两轮",
   "budget_exhausted: 重试或成本用尽"
  ],
  "artifact": "锁定提取表 + 来源定位 + 分歧/仲裁日志 + 抽查报告 + 合并分析输出 + 签字记录"
 },
 "execution_contract": {
  "external_execution": false
 },
 "anchors": [
  {
   "node_id": "anchor_sources",
   "source": "40 篇纳入文献原文 PDF（哈希冻结）与预注册方案",
   "evidence_form": "原文表格/正文的页码与表号定位",
   "owner": "Bruce",
   "freshness_rule": "纳入集合或方案变更时失效，需重新冻结并重新确认",
   "frozen": true,
   "max_age_days": 180,
   "last_confirmed": "2026-11-15"
  }
 ],
