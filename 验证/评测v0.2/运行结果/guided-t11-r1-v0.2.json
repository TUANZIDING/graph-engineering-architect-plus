   "id": "extract_b_blind",
   "kind": "verification_loop",
   "responsibility": "Agent B 在不接触提取表A的前提下，独立从原文双提取，并做单元格级比对，产出分歧清单；对无定位或不一致单元格有否决权",
   "owner": "Agent B（不同模型/新上下文）",
   "cadence": "每批文献",
   "cadence_tier": "medium",
   "max_iterations": 2,
   "context_scope": "fresh-independent",
   "evidence_sources": [
    "冻结原文副本"
