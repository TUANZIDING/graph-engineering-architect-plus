      "evidence_form": "带哈希的冻结留出数据快照 + 冻结评估脚本输出",
      "owner": "数据治理负责人（Bruce 指定）",
      "freshness_rule": "每月由审计回路滚动重建并重新冻结；超过 45 天未确认视为过期，过期则禁止上线",
      "frozen": true,
      "max_age_days": 45,
      "last_confirmed": "2026-11-15"
    },
    {
      "node_id": "prospective-shadow-outcomes",
      "source": "影子部署期间新出科患者的真实 72h 再入院结局（医院再入院登记，非模型产生）",
      "evidence_form": "影子期预测与登记结局对照表",
      "owner": "临床质控科",
      "freshness_rule": "每周更新，仅纳入出科已满 72h 且登记延迟已过的病例；超过 14 天无更新视为过期",
      "frozen": true,
      "max_age_days": 14,
      "last_confirmed": "2026-11-15"
    }
