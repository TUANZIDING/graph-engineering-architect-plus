{
  "schema_version": "1.1",
  "title": "ICU 72h 再入院预测模型持续改进图",
  "mode": "graph_plus_loop",
  "state": "designed",
  "root_goal": {
    "statement": "在不损害患者安全的前提下，持续维持或提升线上 ICU 72 小时再入院预测模型在未来真实患者上的判别力与校准，用于支持（而非替代）临床出科决策",
    "human_owner": "Bruce",
    "observable_success": "候选模型在训练从未接触、时间上晚于训练窗口的冻结留出集与前瞻影子期真实结局上：AUC 不劣于线上模型（DeLong 非劣界 0.01，且 95%CI 下界更优才算'提升'）、校准斜率 0.8–1.2 且 Brier 不变差、关键亚组 AUC 不下降超过 0.02；并由 Bruce（及临床负责人）签字后才替换线上模型",
    "out_of_scope": [
      "用训练同一个月的数据计算 AUC 作为上线依据",
      "AUC 上升后无人工签字自动替换线上模型",
      "Agent 修改留出集、标签定义、评估脚本、阈值或上线规则",
      "直接据模型输出改变个体患者出科/转科决策"
    ],
    "metrics": [
      "holdout_auc",
      "calibration_slope",
      "brier",
      "subgroup_auc_gap",
      "prospective_shadow_auc",
      "alert_rate"
    ]
  },
  "classification_rationale": "原方案是单回路且自评：同一个月数据既训练又算 AUC（样本内/泄漏），AUC 即刷分目标，且直接改线上临床模型（高风险副作用）。需要：独立冻结的时间外留出锚点、独立验证者、校准/亚组/漂移反指标、数据与标签审计、人工上线门和回滚，多个回路节奏不同（周训练、每候选验证、月审计、季度治理），因此是图；训练节点本身是一个有界内部回路，故为 graph_plus_loop",
  "permissions": {
    "human_owner": "Bruce",
    "allowed_actions": [
      "在冻结特征与标签定义内，用标签已成熟的最近数据窗口训练候选模型",
      "在沙箱中运行冻结评估脚本并生成报告",
      "以影子模式部署候选（仅记录预测，不影响临床）",
      "提交上线提议与回滚提议"
    ],
    "forbidden_actions": [
      "未经人工签字替换线上模型",
      "读取或改写冻结留出集与前瞻影子结局",
      "修改标签定义、评估脚本、AUC/校准阈值或上线规则",
      "用训练数据自评作为上线证据",
      "导出可识别患者数据到受控环境之外"
    ]
  },
  "frozen_rules": [
    "72 小时再入院标签定义（出 ICU 后 72h 内再入 ICU，计时起点、转院/死亡处理）冻结，仅 Bruce 批准可改",
    "训练窗口与评估窗口严格时间分离：评估只用训练截止之后、且已满 72h+数据延迟的成熟标签数据；同一患者不跨集",
    "冻结留出集与评估脚本由数据治理方持有，训练 Agent 只读不到",
    "上线判据：AUC 95%CI 下界优于线上且校准、Brier、亚组、告警率反指标全部通过，任一失败即否决",
    "替换线上模型必须经人工门签字，并保留可一键回滚的前一版本"
  ],
  "approval": {
    "status": "pending"
  },
  "budget": {
    "max_agents": 6,
    "max_concurrency": 2,
    "max_retries": 2,
    "max_cost_units": 40
  },
  "failure_policy": {
    "failed": "候选被否决：保留线上模型不变，记录否决原因，下周重新训练；连续 4 周失败升级给 Bruce 复核数据与目标",
    "blocked": "留出集过期、标签未成熟、数据审计不通过或锚点无法访问时停止训练与上线流程，线上模型保持，升级给 Bruce",
    "budget_exhausted": "本周不再训练，提交现有证据与 handoff，线上模型保持"
  },
  "stop_handoff": {
    "owner": "Bruce",
    "conditions": [
      "completed: 候选通过全部冻结检查且 Bruce 签字上线，影子/上线监测稳定 4 周",
      "failed: 候选被验证或反指标否决，线上不变",
      "blocked: 锚点过期/数据审计失败/线上性能告警触发回滚，等待人工处理",
      "budget_exhausted: 重试或成本用尽，交接现状"
    ],
    "artifact": "handoff.md（模型版本、评估报告、反指标结果、审计结论、签字记录、回滚指针）"
  },
  "execution_contract": {
    "external_execution": false
  },
  "governance": {
    "arbitration": {
      "owner": "Bruce",
      "priority_policy": "患者安全与数据合规 > 校准与亚组公平 > 前瞻/留出判别力 AUC > 训练效率与更新频率；任一高优先级信号失败即否决低优先级的改进"
    },
    "goal_change": "human_approval",
    "approval_required": [
      "Root-goal change",
      "Anchor change",
      "Permission expansion",
      "Label definition change",
      "Promotion threshold change",
      "Production model replacement"
    ]
  },
  "verification": {
    "independence_statement": "验证者使用独立团队持有的冻结评估脚本，在训练 Agent 无法访问、时间晚于训练窗口的留出集和前瞻影子期真实结局上评估；评估者与数据来源都独立于训练回路，不复用训练 Agent 自报的 AUC",
    "checks": [
      "independent-validator",
      "counter-metric-check",
      "data-label-audit"
    ]
  },
  "external_inputs": [
    "icu_ehr_feed",
    "readmission_outcome_registry",
    "frozen_label_definition"
  ],
  "anchors": [
