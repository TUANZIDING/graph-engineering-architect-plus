{
  "schema_version": "1.1",
  "title": "科研代码库失败测试修复系统（测试冻结 + 人工合并门）",
  "mode": "graph_plus_loop",
  "state": "designed",
  "root_goal": {
    "statement": "科研代码库的真实行为正确：在不削弱既有测试、不改变科学计算结果的前提下，修复导致测试失败的源代码缺陷，并经 Bruce 批准后合入主分支。",
    "human_owner": "Bruce",
    "observable_success": "在干净 CI 中，候选分支通过 Bruce 冻结（哈希锁定）的基线测试套件 + Bruce 持有的留出测试 + 参考科学输出回归比对（数值容差不放宽），且测试完整性检查无削弱（无删除/跳过/xfail/放宽断言/放宽容差，变异得分不下降），并由 Bruce 签字合并。",
    "out_of_scope": [
      "Agent 自行修改、删除、跳过、放宽既有测试或数值容差",
      "Agent 自动合并到主分支（main）",
      "改动 CI 配置、测试运行器、覆盖率/变异阈值或参考输出",
      "以“测试全绿”单独作为完成标准",
      "改变科学方法或分析口径（属于研究决策，归 Bruce）"
    ],
    "metrics": [
      "失败测试数",
      "冻结基线通过率",
      "留出测试通过率",
      "参考输出一致率",
      "变异得分",
      "测试削弱事件数",
      "新增测试覆盖"
    ]
  },
  "classification_rationale": "原始方案里“测试全绿=完成”+“Agent 自己改测试”+“自动合并”构成元回路劫持：优化者能改写自己的裁判，最省力的路径就是删/跳/放宽测试，全绿变得毫无意义，且直接污染 main。单回路不够：需要（1）优化者碰不到的冻结锚点（哈希锁定基线测试、Bruce 留出测试、参考科学输出），（2）独立 CI 验证者，（3）专抓测试削弱的反指标回路，（4）审计 flaky/锚点漂移的慢回路，（5）合并与测试入库的人工门。故采用 graph_plus_loop：内部修复是一个有界执行回路，外部用图提供扎根、否决与治理。Agent 新增测试只能作为提案，经 Bruce 批准后才进入冻结套件；不支持原需求中的自动合并与自改测试。",
  "permissions": {
    "human_owner": "Bruce",
    "allowed_actions": [
      "在隔离的 fix/* 分支修改 src/ 下的源代码",
      "在本地沙箱运行测试",
      "在 proposed-tests/ 目录新增测试用例提案（仅新增，不进入冻结套件）",
      "开 Pull Request 并附修复说明与证据"
    ],
    "forbidden_actions": [
      "修改、删除、跳过、标记 xfail 或放宽冻结基线测试与数值容差",
      "读取或修改 Bruce 留出测试与参考输出",
      "修改 CI 配置、测试运行器、conftest、覆盖率与变异阈值",
      "推送或合并到 main",
      "改变科学算法的计算口径以迎合测试"
    ]
  },
  "frozen_rules": [
    "基线测试套件以 SHA-256 清单锁定，只有 Bruce 批准才能更新清单",
    "留出测试与参考科学输出由 Bruce 保管，执行回路不可读不可写",
    "数值容差、覆盖率与变异得分阈值冻结",
    "CI 配置与测试运行器冻结",
    "main 分支受保护，合并必须 Bruce 签字",
    "测试只能增不能减；新增测试须经 Bruce 批准方可入冻结套件"
  ],
  "approval": {
    "status": "pending"
  },
  "budget": {
    "max_agents": 7,
    "max_concurrency": 2,
    "max_retries": 2,
    "max_cost_units": 40
  },
  "failure_policy": {
    "failed": "候选被否决：退回修复回路并附否决理由；同一缺陷连续 3 次被否决则停止并移交 Bruce",
    "blocked": "锚点过期、CI 不可用、或修复必须改测试/改科学口径才能通过：停止并升级给 Bruce，不得绕过",
    "budget_exhausted": "达到迭代或成本上限：停止，提交未解决失败清单与已尝试方案的 handoff.md 给 Bruce",
    "stalled": "连续 2 轮失败测试数无下降：停止并移交"
  },
  "stop_handoff": {
    "owner": "Bruce",
    "conditions": [
      "completed：冻结基线+留出测试+参考输出全部通过、完整性检查无削弱、Bruce 签字合并",
      "failed：同一缺陷连续 3 次被否决",
      "blocked：锚点过期或修复需改测试/改科学口径",
      "budget_exhausted：迭代或成本耗尽"
    ],
    "artifact": "handoff.md"
  },
  "execution_contract": {
    "external_execution": false
  },
  "governance": {
    "arbitration": {
      "owner": "Bruce",
      "priority_policy": "科学正确性（参考输出一致） > 测试完整性（无削弱） > 冻结基线与留出测试通过 > 新增测试覆盖 > 修复速度。任一上层否决即不合并；测试本身疑似错误时只能由 Bruce 判定并修改锚点。"
    },
    "goal_change": "human_approval",
    "approval_required": [
      "Root-goal change",
      "Anchor change（基线清单、留出测试、参考输出、容差）",
      "Permission expansion",
      "新增测试进入冻结套件",
      "合并到 main"
    ]
  },
  "verification": {
    "independence_statement": "CI 验证者在干净容器中从受保护仓库检出冻结测试清单与 Bruce 留出测试独立执行，不使用修复 Agent 的运行日志或其提交的测试；测试完整性检查直接对比 git diff 与冻结清单并运行变异测试。评估者与数据来源都与执行回路不同。",
    "checks": [
      "ci_verifier",
      "test_integrity_counter"
    ]
  },
  "external_inputs": [
    "失败测试报告（来自 main 的 CI）",
    "代码库 main 快照"
  ],
  "anchors": [
