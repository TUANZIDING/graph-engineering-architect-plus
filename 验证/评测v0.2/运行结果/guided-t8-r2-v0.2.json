{
 "schema_version": "1.1",
 "title": "科研代码库失败测试修复系统（测试与合并权限分离版）",
 "mode": "graph_plus_loop",
 "state": "designed",
 "classification_rationale": "原设计让同一个编程 Agent 既修代码、又改测试、又自动合并，而完成判据是“测试全绿”：改进者能改写自己的裁判（删/弱化断言、加 skip、改期望值即可变绿），这是典型的元回路劫持与刷分。单回路不够：需要冻结的测试锚点、独立 CI 验证者、反指标（变异测试/断言删减/科学参考输出）、合并前人工门，以及修代码与补测试两条速度不同的回路之间的仲裁。存在执行者无法改写的证据源（冻结基线测试 + 科学参考输出 + 干净 CI 实际执行），因此不是 blocked，而是 graph_plus_loop。",
 "root_goal": {
  "statement": "科研代码库在冻结的基线测试与科学参考输出上真实通过，且新增测试真正提升缺陷检出能力，而不是通过改测试让结果变绿。",
  "human_owner": "Bruce",
  "observable_success": "在干净 CI 环境中，从 main 检出：冻结基线测试套件 100% 通过且 skip/xfail 数不增加；科学参考输出（黄金数据集的数值结果）在预设容差内复现；新增测试经变异测试证明能杀死变异体且在修复前代码上能失败；断言总数与覆盖率不下降；每次合并有 Bruce 的批准记录。",
  "metrics": [
   "frozen_suite_pass_rate",
   "reference_output_reproduction",
   "mutation_kill_rate",
   "assertion_count_delta",
   "skip_xfail_count"
  ],
  "out_of_scope": [
   "Agent 修改或删除已有测试、期望值、容差、CI 配置",
   "Agent 直接合并到 main",
   "改动科研算法的科学含义以通过测试"
  ]
 },
 "permissions": {
  "human_owner": "Bruce",
  "allowed_actions": [
   "在 feature 分支修改非测试源代码",
   "在独立分支新增测试文件（仅新增）",
   "运行本地测试",
   "开 PR 并附证据包",
   "提议修改已有测试（仅以提案形式提交 Bruce）"
  ],
  "forbidden_actions": [
   "修改或删除冻结基线测试、断言、期望值、容差",
   "添加 skip/xfail/条件跳过标记",
   "修改 CI 配置、测试运行器、覆盖率/变异阈值",
   "修改科学参考输出数据",
   "直接推送或自动合并到 main",
   "修改本图的目标、锚点、权限或冻结规则"
  ]
 },
 "frozen_rules": [
  "基线测试套件在启动时按 commit hash 冻结，任何改动需 Bruce 批准并记录",
  "科学参考输出与容差由 Bruce 拥有，Agent 只读",
  "CI 配置、测试运行器、阈值对执行回路只读（CODEOWNERS + 分支保护）",
  "合并到 main 必须经 Bruce 批准；不允许自动合并",
  "修代码与补测试不得在同一个 PR 中完成，补测试的 PR 不得包含源代码修复",
  "完成判据不能只是“测试全绿”，必须同时满足反指标与参考输出"
 ],
 "approval": {
  "status": "pending"
 },
 "budget": {
  "max_agents": 7,
  "max_concurrency": 2,
  "max_retries": 3,
  "max_cost_units": 200
 },
 "failure_policy": {
  "failed": "单个失败测试修复达迭代上限仍未通过，或验证/反指标持续否决 → 停止该项，升级 Bruce，不得降低标准重试",
  "blocked": "失败疑似源于测试本身错误或需求不明 → 以提案提交 Bruce 裁决，不得自行修改测试；锚点过期或哈希不符 → 全局暂停",
  "budget_exhausted": "成本或迭代预算耗尽 → 停止并交接未完成清单与证据包"
 },
 "stop_handoff": {
  "owner": "Bruce",
  "conditions": [
   "completed: 冻结套件全绿 + 参考输出复现 + 反指标无告警 + Bruce 批准合并",
   "blocked: 失败源于测试本身疑似错误或需求不明，等待 Bruce 裁决",
   "failed: 达到重试/迭代上限仍未修复，或验证持续否决",
   "budget_exhausted: 成本或迭代预算耗尽，交接未完成清单"
  ],
  "artifact": "handoff.md：已修复/未修复测试清单、每个 PR 的证据包、反指标报告、待 Bruce 裁决的测试修改提案"
 },
 "execution_contract": {
  "external_execution": false
 },
