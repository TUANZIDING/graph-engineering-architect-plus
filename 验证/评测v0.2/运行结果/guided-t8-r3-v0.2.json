{
 "schema_version": "1.1",
 "title": "科研代码库失败测试自动修复——受控图",
 "mode": "graph_plus_loop",
 "state": "designed",
 "root_goal": {
  "statement": "科研代码库在 Bruce 冻结的受保护测试集与科学参考输出上全部通过，且测试集本身未被削弱，代码以经批准、可回滚的方式进入 main",
  "human_owner": "Bruce",
  "observable_success": "隔离 CI 从受保护 ref 执行 tests/protected 连续 3 次全绿；受保护测试/CI 配置 diff 为空且无新增 skip/xfail/容差放宽；golden 参考数值一致；变更代码变异得分不下降；每次合入 main 有 Bruce 批准记录",
  "out_of_scope": [
   "Agent 自动合并到 main（原需求，改为 Bruce 审批后合并）",
   "Agent 修改、删除、跳过或放宽既有/受保护测试与参考输出",
   "Agent 修改 CI 配置、依赖锁、阈值或成功定义",
   "以 Agent 新增的测试作为'全绿'完成证据",
   "改动科研结论/算法语义以迎合测试"
  ],
  "metrics": [
   "protected_failing_test_count",
   "new_covered_behaviors",
   "mutation_score",
   "golden_output_agreement"
  ]
 },
 "classification_rationale": "原需求让同一个 Agent 既修代码、又改测试、又自动合并——改进者能改写自己的裁判（测试），'测试全绿'就可通过删/改/skip 测试廉价达成，是典型元回路劫持与刷指标。单回路无法自察，因此需要图：冻结的受保护测试与隔离 CI 作现实锚点、独立验证者与反指标拥有否决权、新测试只能提案并经人工晋升、合并改为人工门；修复回路本身需持久状态（graph_plus_loop，fix_loop 交给 loop-engineering 实例化）。",
 "permissions": {
  "human_owner": "Bruce",
  "allowed_actions": [
   "在 agent/* 分支修改非测试源码",
   "在 tests/proposed/ 新增测试提案",
   "触发隔离 CI 运行",
   "生成合并建议与交接报告"
  ],
  "forbidden_actions": [
   "直接推送或自动合并到 main",
   "修改/删除/skip/xfail tests/protected 与 conftest",
   "修改 CI 配置、依赖锁、覆盖率或容差阈值",
   "修改 golden 参考输出",
   "修改验证/反指标/审计节点的逻辑",
   "强制推送或改写 main 历史"
  ]
 },
 "frozen_rules": [
  "tests/protected、conftest.py、golden 参考输出、CI 配置受 CODEOWNERS=Bruce 与分支保护，Agent 只读",
  "'全绿'仅以隔离 CI 从受保护 ref 执行的受保护测试为准，Agent 新增测试不计入",
  "Agent 新增测试只能进 tests/proposed/，晋升需 Bruce 批准",
  "合并 main 必须有 Bruce 批准记录 + 合并前 CI 再验",
  "任一检查者否决即不得合并",
  "锚点、阈值、权限、根目标的变更只能提议，经 Bruce 批准生效"
 ],
 "approval": {
  "status": "pending"
 },
 "budget": {
  "max_agents": 8,
  "max_concurrency": 3,
  "max_retries": 2,
  "max_cost_units": 40
 },
 "failure_policy": {
  "failed": "补丁回滚/丢弃分支，记录否决原因并交接 Bruce",
  "blocked": "锚点过期、CI 不可用或受保护测试本身疑似错误时停机，升级 Bruce 决定是否修订锚点",
  "budget_exhausted": "停止迭代，输出未修复测试清单与尝试记录交接 Bruce",
  "stalled": "连续 2 轮失败测试数不下降即停止并升级"
 },
 "stop_handoff": {
  "owner": "Bruce",
  "conditions": [
   "completed: 受保护测试隔离 CI 连续全绿且反指标通过、Bruce 批准并合入",
   "failed: 合并后 CI/审计发现回归，已 revert",
   "blocked: 锚点过期或受保护测试被判定有误，待 Bruce 裁决",
   "budget_exhausted: 达到 max_iterations/成本上限仍有失败测试"
  ],
  "artifact": "handoff.md"
 },
 "execution_contract": {
  "external_execution": false
 },
