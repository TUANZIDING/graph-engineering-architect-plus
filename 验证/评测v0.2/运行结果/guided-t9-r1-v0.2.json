{
 "schema_version": "1.1",
 "title": "胸痛分诊助手提示词优化控制架构",
 "mode": "graph_plus_loop",
 "state": "designed",
 "root_goal": {
  "statement": "让急诊预检台胸痛分诊助手安全地给出分级建议：高危胸痛（STEMI/NSTE-ACS、主动脉夹层、肺栓塞、张力性气胸等时间敏感病因）不漏分、不降级，同时不过度占用抢救资源；三年前的科室标准只是代理指标，不是根结果",
  "human_owner": "Bruce",
  "observable_success": "在优化回路从未见过的封存留出病例集（含最终确诊/30天MACE结局）上：高危病例漏分（under-triage）率≤预设上限且不劣于现行人工预检；各亚组（女性、老年、糖尿病、不典型表现）无显著劣化；过度分诊率在科室可接受范围；分级与经现行指南复核修订后的标准一致率达标；静默影子运行≥4周无高危漏分事件；经科室主任、护士长与Bruce签字后才可作为预检台决策支持（护士保留最终分级权）",
  "out_of_scope": [
   "让助手自动替代分诊护士作最终分级",
   "Agent自行修改或重新解释科室胸痛标准",
   "未经伦理/信息科审批使用可识别患者数据",
   "非胸痛主诉分诊",
   "把与旧标准一致率本身当作上线依据"
  ],
  "metrics": [
   "agreement_with_department_standard",
   "high_risk_under_triage_rate",
   "over_triage_rate",
   "subgroup_sensitivity",
   "outcome_concordance"
  ]
 },
 "classification_rationale": "单回路只优化与旧标准的一致率会把三年前标准的过时之处和漏判一起学进去（错误目标+测量衰减），且提示词改写者会对开发集过拟合（刷分）；高危临床场景需要独立结局锚点、反指标、标准有效性慢回路和上线人工门，因此需要图；提示词改写本身是一个有界执行回路，故为graph_plus_loop",
 "permissions": {
  "human_owner": "Bruce",
  "allowed_actions": [
   "在开发集上改写候选提示词",
   "在封存留出集上由验证者运行候选并出报告",
   "提出对科室标准的修订建议",
   "在影子模式下记录助手建议但不展示给患者处置流程"
  ],
  "forbidden_actions": [
   "读取或抽样封存留出集与结局标签",
   "修改科室标准、评测脚本、阈值或优先级",
   "在获批前把助手接入真实预检流程",
   "提示词中硬编码留出病例内容",
   "使用未脱敏患者数据"
  ]
 },
 "frozen_rules": [
  "封存留出病例集及其最终诊断/30天结局标签只读，优化回路不可见",
  "高危漏分率上限与亚组底线由人设定，Agent不可改",
  "科室胸痛标准版本冻结，修订只能经标准有效性复审+人工门",
  "评测脚本与分级映射表冻结（哈希登记）",
  "优先级：患者安全（高危不漏分）> 真实结局一致 > 现行指南 > 与旧标准一致率 > 过度分诊/效率",
  "上线前必须影子运行且人工签字，护士保留最终分级权"
 ],
 "approval": {
  "status": "pending"
 },
 "budget": {
  "max_agents": 8,
  "max_concurrency": 2,
  "max_retries": 2,
  "max_cost_units": 40
 },
 "failure_policy": {
  "failed": "候选未过验证者否决即丢弃，回到上一版通过的提示词；连续失败达迭代上限则停并交给Bruce",
  "blocked": "留出集/结局数据不可得或锚点过期时停在设计稿，不以旧标准一致率替代，交Bruce处理数据与伦理审批",
  "budget_exhausted": "冻结当前最佳已验证候选，不上线，提交交接报告给Bruce"
 },
 "stop_handoff": {
  "owner": "Bruce",
  "conditions": [
   "completed：候选通过验证、反指标、审计与影子运行，并获人工签字",
   "failed：高危漏分无法降到上限以内或亚组劣化无法消除",
   "blocked：结局锚点缺失/过期或标准有效性存疑未裁决",
   "budget_exhausted：迭代或成本预算用尽"
  ],
  "artifact": "handoff.md（最佳候选提示词、留出集报告、反指标报告、标准分歧清单、影子运行记录）"
 },
