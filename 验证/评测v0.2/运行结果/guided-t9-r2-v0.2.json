      "failed: 达到迭代上限仍无候选满足低分诊阈值",
      "blocked: 标准复审未通过/锚点过期/伦理未批准",
      "budget_exhausted: 预算用尽"
    ],
    "artifact": "handoff.md"
  },
  "execution_contract": {
    "external_execution": false
