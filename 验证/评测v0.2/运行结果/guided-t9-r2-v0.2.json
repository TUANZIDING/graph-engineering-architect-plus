{
  "schema_version": "1.1",
  "title": "急诊胸痛分诊助手提示词优化控制图",
  "mode": "graph_plus_loop",
  "state": "designed",
  "root_goal": {
    "statement": "让急诊预检台胸痛分诊助手对时间敏感高危胸痛（STEMI/NSTE-ACS、主动脉夹层、肺栓塞、张力性气胸等）不漏分、不低分，并在护士最终决策下安全辅助分级；与三年前科室标准的一致率只是代理指标，不是根结果",
    "human_owner": "Bruce",
    "observable_success": "在优化者不可见、按出院诊断与30天MACE双人盲法裁定的封存胸痛病例集上：高危病例低分诊率≤预设上限（由Bruce与胸痛中心共同签字设定）、关键亚组（女性、≥75岁、糖尿病、非典型症状）无显著劣化；经复审后的标准一致率不低于基线；随后影子模式（不影响真实分诊）前瞻运行期内无新增低分诊安全事件，并经伦理/医务部门签字",
    "out_of_scope": [
      "助手自主决定分诊级别或替代预检护士判断",
      "未经复审直接把三年前的标准当作不可质疑的真值",
      "修改科室分诊标准、封存病例集或安全阈值",
      "诊断、治疗或处置建议",
      "未经批准在真实预检台上线"
    ],
    "metrics": [
      "agreement_with_reviewed_standard",
      "high_risk_undertriage_rate",
      "subgroup_undertriage_gap",
      "overtriage_rate"
    ]
  },
  "classification_rationale": "单回路只会把‘与旧标准一致率’刷高：旧标准可能已过时（指南与高敏肌钙蛋白路径更新），一致率可通过迎合标准措辞、过度保守或在开发集过拟合被钻空子，且临床部署是高风险副作用。需要：独立于优化者的结局锚点验证、低分诊/亚组反指标、对标准本身与数据漂移的审计、安全优先的仲裁、标准修订与上线的人工门，故为图；提示词改写本身是图内一个有界单回路，故 graph_plus_loop。",
  "permissions": {
    "human_owner": "Bruce",
    "allowed_actions": [
      "在开发集上改写分诊助手提示词候选",
      "在隔离沙箱运行候选并记录日志",
      "提议标准修订、阈值修订或目标修订（仅提议）",
      "生成验证、反指标、审计与交接报告"
    ],
    "forbidden_actions": [
      "读取或修改封存结局病例集及其标签",
      "修改科室分诊标准文本或复审结论",
      "修改验证脚本、反指标阈值或仲裁优先级",
      "在真实预检台部署或影响真实患者分级",
      "将患者可识别信息带出院内环境"
    ]
  },
  "frozen_rules": [
    "封存结局病例集（出院诊断+30天MACE，双人盲法裁定）只读，优化回路不可见其标签",
    "高危胸痛低分诊率上限与亚组劣化阈值由Bruce签字设定，优化者不可改",
    "安全优先：低分诊高危病例的代价高于任何一致率提升",
    "科室标准的任何修订须经胸痛中心/心内与急诊专家复审并由Bruce批准",
    "助手只作辅助，预检护士保留最终分级权",
    "上线前必须经伦理/医务批准并完成影子模式运行"
  ],
  "approval": {
    "status": "pending"
  },
  "budget": {
    "max_agents": 6,
    "max_concurrency": 2,
    "max_retries": 2,
    "max_cost_units": 40
  },
  "failure_policy": {
    "failed": "候选被验证或反指标否决且达到迭代上限：保留当前最佳已通过版本（或无版本），写交接报告给Bruce",
    "blocked": "标准复审未完成、封存集不可用或锚点过期：停止优化，升级给Bruce",
    "budget_exhausted": "停止迭代，提交最佳已验证候选及未解决风险清单，不得上线"
  },
  "stop_handoff": {
    "owner": "Bruce",
