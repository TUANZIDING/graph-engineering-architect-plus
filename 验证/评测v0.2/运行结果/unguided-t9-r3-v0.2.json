    {"from": "standard_governance", "to": "anchor_reviewed_standard", "relation": "observes", "artifact": "standard_revision_proposal"},
    {"from": "standard_governance", "to": "prompt_optimizer", "relation": "constrains", "artifact": "pause_signal"},
    {"from": "standard_governance", "to": "result_synthesis", "relation": "feeds", "artifact": "standard_revision_proposal"},
    {"from": "standard_governance", "to": "stop_handoff", "relation": "escalates", "artifact": "pause_signal"},
    {"from": "result_synthesis", "to": "gate_deployment", "relation": "feeds", "artifact": "evidence_package"},
    {"from": "result_synthesis", "to": "stop_handoff", "relation": "feeds", "artifact": "evidence_package"},
    {"from": "gate_deployment", "to": "stop_handoff", "relation": "hands_off", "artifact": "deployment_decision"}
