    {"from": "anchor_reviewed_standard", "to": "prompt_optimizer", "relation": "anchors", "artifact": "reviewed_standard_v1"},
    {"from": "data_curation", "to": "holdout_verifier", "relation": "feeds", "artifact": "sealed_holdout_set"},
    {"from": "data_curation", "to": "safety_counter_metric", "relation": "feeds", "artifact": "sealed_holdout_set"},
    {"from": "anchor_outcome_labels", "to": "safety_counter_metric", "relation": "anchors", "artifact": "outcome_labels"},
    {"from": "prompt_optimizer", "to": "holdout_verifier", "relation": "feeds", "artifact": "prompt_candidate"},
    {"from": "prompt_optimizer", "to": "safety_counter_metric", "relation": "feeds", "artifact": "prompt_candidate"},
    {"from": "prompt_optimizer", "to": "integrity_audit", "relation": "feeds", "artifact": "change_log"},
    {"from": "holdout_verifier", "to": "prompt_optimizer", "relation": "verifies", "artifact": "holdout_report"},
    {"from": "holdout_verifier", "to": "conflict_arbitration", "relation": "feeds", "artifact": "holdout_report"},
    {"from": "holdout_verifier", "to": "integrity_audit", "relation": "feeds", "artifact": "holdout_report"},
    {"from": "safety_counter_metric", "to": "prompt_optimizer", "relation": "vetoes", "artifact": "safety_veto"},
    {"from": "safety_counter_metric", "to": "conflict_arbitration", "relation": "feeds", "artifact": "safety_report"},
