{
  "schema_version": "1.1",
  "title": "急诊脓毒症预警阈值治理图（误报负担 vs 漏报安全）",
  "mode": "graph_plus_loop",
  "state": "designed",
  "root_goal": {
    "statement": "降低急诊护士面对的无临床意义脓毒症预警负担（目标：可操作性差的报警减少约50%），同时不降低对真正脓毒症的检出与提前量；'自动调高阈值'只是候选手段之一，不是目标本身。",
    "human_owner": "Bruce（急诊科医师，需求提出人与临床责任人）",
    "observable_success": "在至少8周前瞻性影子/分阶段评估中，以独立盲法裁定的脓毒症结局为金标准：(1) 每100次就诊的非可操作报警数较基线下降≥50%；(2) 裁定脓毒症灵敏度不低于基线的95%置信区间下限，且漏报/延迟识别病例数不增加；(3) 高危亚组（老年、免疫抑制、感染性休克）灵敏度不下降；(4) 预警到抗生素时间不变差；(5) 每次生产阈值变更均有临床委员会签字记录。",
    "out_of_scope": [
      "Agent直接修改生产环境预警阈值或报警逻辑",
      "仅以护士'误报'标记作为真值或唯一优化目标",
      "更改Sepsis-3裁定标准、结局定义或安全底线",
      "厂商算法内部模型重训（属于厂商变更控制流程）",
      "对个别护士标记行为的绩效考核"
    ],
    "metrics": [
      "nonactionable_alert_rate",
      "adjudicated_sensitivity",
      "missed_or_delayed_sepsis_count",
      "ppv",
      "subgroup_sensitivity",
      "alert_to_antibiotic_time"
    ]
  },
  "classification_rationale": "不是单回路：用户提出的回路以护士'误报'标记为唯一反馈，并直接调高阈值，这是经典的Goodhart陷阱——调高阈值必然减少报警（包括真脓毒症报警），护士标记本身受报警疲劳和信息不完整（结局在72小时~30天后才确定）影响，不是真值。需要：独立的结局裁定锚点、漏报反指标、标签质量审计、快慢分层（每周提议 vs 季度目标审查），以及生产变更前的人工临床门。存在多个相互拉扯的目标（报警负担 vs 患者安全），必须预先定仲裁顺序，因此为graph；调参节点内部是有界回路，故graph_plus_loop。",
  "permissions": {
    "human_owner": "Bruce",
    "allowed_actions": [
      "读取去标识化的报警日志、护士标记与EHR结局数据（经伦理/信息科批准范围内）",
      "在回顾性数据与影子模式中评估候选阈值/分层报警规则",
      "生成阈值变更提案与证据包",
      "向安全反指标与审计回路提交候选供否决"
    ],
    "forbidden_actions": [
      "直接写入生产预警系统阈值或报警逻辑",
      "修改或筛选结局裁定数据、Sepsis-3裁定标准",
      "修改安全底线（灵敏度下限、漏报上限）或冻结规则",
      "删除、重标或隐藏护士标记与漏报病例",
      "未经临床委员会签字推广到其他科室"
    ]
  },
  "frozen_rules": [
    "结局真值=独立盲法临床医师按Sepsis-3（及院内脓毒症质控口径）裁定，不以护士'误报'标记为真值；裁定者不知道候选阈值。",
    "安全底线：裁定脓毒症灵敏度不得低于基线95%CI下限；漏报/延迟识别病例数不得高于基线；任一高危亚组灵敏度不得下降。任一触发即否决。",
    "生产阈值变更最多每季度一次，单次幅度有上限，变更后至少8周观察窗，期间不再改。",
    "任何生产变更必须经急诊科主任、脓毒症质控小组与信息科/厂商变更控制签字，并有回滚方案。",
    "Agent只能提议；目标、锚点、安全底线、裁定标准与权限的修改只能经人工门。",
    "出现漏报导致的严重不良事件时立即回滚到上一个已批准阈值并上报。"
  ],
  "approval": {
    "status": "pending"
  },
  "budget": {
    "max_agents": 6,
    "max_concurrency": 2,
    "max_retries": 1,
    "max_cost_units": 20
  },
  "failure_policy": {
    "failed": "候选被安全反指标或验证否决：保持现行生产阈值不变，记录否决原因，下一周期只允许提议非阈值类干预（分层报警、重复报警抑制、工作流改进）。",
    "blocked": "结局裁定数据缺失/过期或标签审计显示护士标记与裁定一致率过低：停止调参提案，升级给Bruce与脓毒症质控小组。",
    "budget_exhausted": "连续3个周期无候选同时满足误报下降与安全底线：停止自动提案，交接报告建议改变干预手段（如报警分级、二次确认）而非继续调阈值。"
  },
  "stop_handoff": {
    "owner": "Bruce",
    "conditions": [
      "completed：观察期满且observable_success全部满足，并有委员会签字",
      "blocked：锚点过期/缺失或标签质量不达标",
      "failed：安全底线被触发或发生漏报相关严重不良事件（立即回滚）",
      "budget_exhausted：连续3个周期无安全可行候选"
    ],
    "artifact": "handoff.md（含现行阈值、证据包、否决记录、回滚记录与下一步建议）"
  },
  "execution_contract": {
    "external_execution": false
  },
  "governance": {
    "arbitration": {
      "owner": "急诊脓毒症质控小组组长（Bruce召集）",
      "priority_policy": "患者安全（灵敏度、漏报、高危亚组、抗生素时效）> 结局数据与标签真实性 > 护士报警负担 > 实施便利与速度；安全否决不可被报警负担改善抵消。"
    },
    "goal_change": "human_approval",
    "approval_required": [
