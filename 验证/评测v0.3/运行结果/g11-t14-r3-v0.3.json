{
  "schema_version": "1.1",
  "title": "急诊脓毒症预警误报治理：阈值调整控制架构",
  "mode": "graph_plus_loop",
  "state": "designed",
  "root_goal": {
    "statement": "在不降低急诊脓毒症识别灵敏度和预警提前量的前提下，把经独立判定确认的误报（报警后72小时内经盲法病历判定不符合 Sepsis-3 的报警）减少约50%，从而减轻护士报警疲劳。",
    "human_owner": "Bruce（丁海祥，急诊创伤外科主治，需求发起人）与急诊科主任共同负责；生产环境阈值变更的签字权归急诊科主任 + 脓毒症质控小组 + 医务处/临床决策支持委员会",
    "observable_success": "连续8周（至少2个完整审批周期）同时满足：(1) 判定误报率或每100例就诊无效报警数较冻结基线下降≥50%；(2) 灵敏度（对全部就诊抽样判定出的脓毒症病例）不低于基线，95%CI下限不低于基线减去委员会预先冻结的非劣效界值；(3) 中位预警提前量不缩短超过委员会冻结的上限；(4) 漏报哨点事件（未报警的脓毒症进展为ICU转入/死亡/休克）经逐例复核无因阈值上调导致的增加；(5) 关键亚组（老年、免疫抑制、低分诊级别）灵敏度无显著下降。",
    "out_of_scope": [
      "Agent 直接修改生产环境预警阈值或模型参数",
      "把护士“误报”标记当作金标准直接训练或调参",
      "以降低灵敏度换取误报数下降的方案",
      "更换或重训厂商预警模型本身（另立项目，走医疗器械/软件变更流程）",
      "对单个护士的绩效评价或追责"
    ],
    "metrics": [
      "adjudicated_false_alarm_rate",
      "sepsis_sensitivity",
      "alert_lead_time",
      "missed_sepsis_sentinel_events",
      "alerts_per_100_visits"
    ]
  },
  "classification_rationale": "原方案是单回路：每周用护士“误报”标记自动上调阈值、以“误报减半”为唯一目标。这是典型的指标可被钻空子的结构：阈值单调上调一定能让误报减少，但代价（漏报、预警延迟）不在护士标记里，也在一周内看不到（脓毒症结局需48–72小时以上判定、死亡/ICU需30天）。护士标记本身有偏（未完成评估就标、疲劳时倾向标误报），不是独立证据。因此需要：独立判定结局锚点、反指标（灵敏度/漏报/提前量）、标签审计、人工签字门、与周节奏分开的较慢变更节奏和季度目标治理。每周提议回路需持久状态与迭代上限，故为 graph_plus_loop。",
  "design_notes": {
    "conclusion_for_bruce": "不建议让 Agent 每周根据护士误报标记自动调高阈值。建议改为：Agent 每周只做分析和提议，候选阈值先在冻结留出数据和影子模式上验证，灵敏度/漏报反指标有否决权，由急诊科主任和委员会签字后最多每4周上线一次，并保留一键回滚。",
    "why": [
      "误报和漏报是同一阈值的两端：只看误报，最优解永远是把阈值调到不报警。",
      "护士“误报”标记是代理指标，必须用盲法病历判定抽样校准，并审计标记行为本身的漂移。",
      "漏报在当周不可见，按周自动上调会在结局显现前叠加多次改动，出事后无法定位是哪一次。",
      "降误报不一定靠阈值：同一患者重复报警抑制窗口、分层报警、加入乳酸/意识等确认条件、报警后处置流程优化，常比整体上调阈值更安全，应作为提议空间的一部分。"
    ],
    "open_items_for_humans": [
      "灵敏度非劣效界值、预警提前量允许缩短上限、单次阈值最大步长：需委员会在首轮运行前冻结",
      "盲法判定小组成员与每周抽样量（需覆盖未报警就诊以发现漏报）",
      "厂商系统是否支持影子模式与版本化配置回滚"
    ]
  },
  "permissions": {
    "human_owner": "Bruce（丁海祥）与急诊科主任；生产变更签字：脓毒症质控小组 + 医务处/临床决策支持委员会",
    "allowed_actions": [
      "读取去标识化的急诊报警日志、护士处置标记与EHR就诊数据",
      "在历史数据和留出集上回放候选阈值或报警规则",
      "在影子模式（只记录不弹窗）下运行候选配置",
      "撰写阈值/规则变更提案并提交人工门",
      "反指标哨点触发时按预批准回滚预案恢复上一版配置"
    ],
    "forbidden_actions": [
      "未经人工门签字修改生产预警阈值或规则",
      "修改或读取冻结留出集的标签以选择候选",
      "修改结局判定标准、判定样本或反指标阈值",
      "单次变更超过委员会冻结的最大步长，或4周内上线第二次变更",
      "删除、改写或选择性隐藏护士标记与报警日志"
    ]
  },
  "frozen_rules": [
    "根目标包含灵敏度不降与预警提前量约束，不能被改写为单纯“误报减半”",
    "结局判定标准（Sepsis-3，72小时，盲法双人判定+分歧仲裁）与抽样方案冻结，修改需人工门批准",
    "冻结留出集（基线期已判定的历史就诊）对提议回路不可见",
    "灵敏度非劣效界值、提前量上限、单次最大步长、最短观察窗4周由委员会在首轮前冻结",
    "生产变更必须先影子模式≥2周，再经签字，且保留上一版配置可一键回滚",
    "任一漏报哨点事件经复核与阈值改动相关时立即回滚并暂停提议回路",
    "Agent 只能提议修改目标、锚点、权限和冻结规则，应用需人工明确批准"
  ],
  "approval": {
    "status": "pending"
  },
  "budget": {
    "max_agents": 6,
    "max_concurrency": 3,
    "max_retries": 1,
    "max_cost_units": 20
  },
  "failure_policy": {
    "failed": "候选未通过验证或反指标否决：本周不提交，记录原因，下周重新分析；连续3周无可行候选则上报仲裁，考虑非阈值手段",
    "blocked": "判定锚点过期、留出集不可用或标签审计不合格：停止提议，交急诊科主任与质控小组恢复锚点",
    "budget_exhausted": "停止迭代，输出当前最佳候选与证据缺口交人工门，不自动上线",
    "rollback": "上线后哨点事件或灵敏度监测越界：按预批准预案恢复上一版配置，暂停提议回路，48小时内人工复盘"
  },
  "stop_handoff": {
    "owner": "急诊科主任（与 Bruce）",
