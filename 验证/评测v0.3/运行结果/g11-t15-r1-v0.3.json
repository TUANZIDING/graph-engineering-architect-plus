{
  "schema_version": "1.1",
  "title": "活的系统综述：每日检索—独立核查—人工签发的控制架构",
  "mode": "graph_plus_loop",
  "state": "designed",
  "root_goal": {
    "statement": "让活的系统综述的证据表、论文结论段和网站推荐意见始终与当前全部合格证据一致且正确，并及时纳入新证据",
    "human_owner": "Bruce（丁海祥，综述负责人）",
    "observable_success": "(1) 每个已合并条目都有独立第二提取一致或仲裁记录，可回溯到PMID/DOI全文；(2) 月度审计中隐藏种子集召回率≥95%、抽样复筛假阴性率≤5%，已撤稿研究在证据表中为0；(3) 每一次结论或推荐意见改动都有锁定代码复算报告和Bruce+临床合作者双签记录，网站内容与最后签字版本一致；(4) 新合格研究从PubMed收录到进入证据表的中位时间≤14天",
    "out_of_scope": [
      "Agent自动改写论文结论段或网站推荐意见",
      "Agent修改检索式、纳排标准、数据字典、分析代码或结论改写阈值",
      "把字段格式齐全当作纳入或合并的充分条件",
      "向期刊投稿、对外发布新闻或个体化医疗建议"
    ],
    "metrics": [
      "eligible_study_recall",
      "extraction_agreement_rate",
      "retracted_studies_in_table",
      "signed_conclusion_changes",
      "median_days_to_inclusion",
      "new_eligible_studies_added"
    ]
  },
  "classification_rationale": "原流程是‘A加条目→B查格式→自动合并→自动改结论和网站推荐’的单线自动化，唯一检查（格式齐全）与内容真伪无关，却直接驱动高风险的对外推荐意见。这里有多个相互作用的目标和速度（每日检索的及时性 vs 证据正确性 vs 结论稳定性），‘纳入数量’可被刷高，需要来源独立的核查与反指标、慢速审计检索漂移、方案修订的治理，以及发布前的人工门；单回路无法约束自己的判据，因此用图；Agent A每日检索本身是持久回路，故为graph_plus_loop。",
  "permissions": {
    "human_owner": "Bruce（丁海祥，综述负责人）",
    "allowed_actions": [
      "Agent A每日按冻结检索式检索并写入暂存区",
      "Agent B校验字段格式并退回不合格条目",
      "独立核查者读取全文与注册记录并否决条目",
      "合并器写入版本化证据表（可回滚）",
      "合成Agent生成结论修改提案（不发布）",
      "审计与治理节点提出修订提案"
    ],
    "forbidden_actions": [
      "任何Agent未经publish_gate签字修改论文结论段或网站推荐意见",
      "Agent A或Agent B直接合并到证据表",
      "执行节点修改检索式、纳排标准、数据字典、分析代码、结论阈值或种子集",
      "删除排除记录或变更日志",
      "未经protocol_change_gate修改冻结锚点"
    ]
  },
  "frozen_rules": [
    "已注册方案（PICO、纳排标准、数据字典、锁定分析代码、GRADE规则、结论改写阈值）只能经protocol_change_gate修订并在PROSPERO登记",
    "隐藏种子集对Agent A不可见且不可写",
    "格式通过只是进入独立提取的前提，不构成合并或改结论的依据",
    "结论段与网站推荐意见的任何改动需要Bruce与一名临床合作者双签",
    "每次合并和发布都必须可回滚并留版本记录",
    "有疑义时保持当前已批准结论不变"
  ],
  "approval": {
    "status": "pending"
  },
  "budget": {
    "max_agents": 10,
    "max_concurrency": 3,
    "max_retries": 2,
    "max_cost_units": 30
  },
  "failure_policy": {
    "failed": "条目核查失败→退回暂存区并记录原因；发布后发现错误→立即回滚到上一签字版本并通知Bruce",
    "blocked": "全文不可得、核查者不可用或锚点过期→条目停留暂存区，不合并；结论保持现状并升级给Bruce",
    "budget_exhausted": "停止当日检索与合成，保留暂存区，交接给Bruce决定是否扩大预算",
    "stalled": "同一条目仲裁超过14天未决→移出本轮，交接文件列明"
  },
  "stop_handoff": {
    "owner": "Bruce（丁海祥，综述负责人）",
    "conditions": [
      "completed：本周期提案已签发或明确决定不改，证据表与网站版本一致",
      "failed：发布内容被审计发现与签字版本或证据不符，已回滚",
      "blocked：冻结锚点过期或核查者缺位，暂停合并与发布",
      "budget_exhausted：成本或重试上限触发",
      "stalled：仲裁或签字超时"
    ],
    "artifact": "handoff.md"
  },
  "execution_contract": {
    "external_execution": false
  },
  "governance": {
    "arbitration": {
      "owner": "Bruce（丁海祥，综述负责人）",
      "priority_policy": "患者安全与结论正确性 > 方案忠实度 > 证据完整性（不漏检）> 更新及时性；有疑义时保持现有已批准结论"
    },
