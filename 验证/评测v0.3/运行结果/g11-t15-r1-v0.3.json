  },
  "verification": {
    "independence_statement": "独立提取者看不到Agent A的条目，直接读全文与注册记录（与A读的PubMed摘要不同来源），且由不同主体承担；结论核查者用锁定代码独立复算，不复用合成Agent的输出数字；反指标与审计读取排除记录抽样、撤稿数据库和对A隐藏的种子集。评估者与数据来源都与执行者分离。",
    "checks": [
      {
        "verifier_node": "format_gate",
        "criterion": "数据字典中必填字段齐全、取值合规",
        "evidence": "确定性校验日志",
        "failure_signal": "任一必填字段缺失或格式不符→退回A"
      },
      {
        "verifier_node": "extraction_verifier",
        "criterion": "合格性判定与关键字段（效应量、样本量、随访、偏倚风险）与独立第二提取一致",
        "evidence": "逐字段比对表＋全文页码",
        "failure_signal": "任一关键字段不一致或合格性分歧→否决合并并升级仲裁"
      },
      {
        "verifier_node": "conclusion_verifier",
        "criterion": "锁定代码复算结果与提案一致，且效应方向/显著性/GRADE确定性跨过预设改写阈值，敏感性分析稳定",
        "evidence": "独立复算报告与新旧版本差异",
        "failure_signal": "复算不一致、未达阈值、文字与数字不符→否决提案"
      }
    ]
  },
