{
  "schema_version": "1.1",
  "title": "活的系统综述：每日PubMed增量 → 证据表 → 结论/网站推荐 控制架构",
  "mode": "graph_plus_loop",
  "state": "designed",
  "root_goal": {
    "statement": "让 Bruce 维护的活系统综述在新证据出现后及时、准确地更新：证据表只收录符合预注册方案的研究，论文结论段落与网站推荐意见始终与当前证据（含偏倚风险与GRADE确定性）相符。",
    "human_owner": "Bruce（综述负责人/通讯作者）",
    "observable_success": "(1) 每次合并的条目可追溯到 PubMed 原始记录与全文，独立双人核查的纳入/提取一致率≥95%，不一致项全部有仲裁记录；(2) 季度召回审计中已知应纳入研究的检出率≥95%；(3) 每次结论/推荐变化都有冻结SAP下的独立复算报告、GRADE表和 Bruce 签字的变更记录，网站推荐与论文结论版本号一致；(4) 无已撤稿或重复人群研究进入合并分析。",
    "out_of_scope": [
      "Agent 自行修改纳入标准、检索式、分析计划或推荐阈值",
      "未经人工签字自动改写论文结论或网站推荐",
      "把字段格式齐全当作纳入合格或证据质量合格",
      "对个体患者给出诊疗建议",
      "向期刊投稿或对外发布更正声明（需 Bruce 另行决定）"
    ],
    "metrics": [
      "conclusion_evidence_concordance",
      "eligible_study_recall",
      "inclusion_extraction_accuracy",
      "new_eligible_studies_added",
      "time_to_incorporate"
    ]
  },
  "classification_rationale": "不是单回路：原流程只有一个反馈信号（字段格式齐全），它是最容易被刷的代理指标，且直接驱动高风险外部副作用（论文结论、公开网站推荐）。这里有多个相互作用、节奏不同的目标——每日纳入速度 vs 纳入/提取准确性 vs 检索召回 vs 结论稳定性——需要独立于 Agent A/B 的现实锚点（预注册方案、PubMed原始记录/全文、撤稿库、已知研究基准集）、反指标、仲裁和人工门；每日增量本身是有界回路，所以选 graph_plus_loop。",
  "permissions": {
    "human_owner": "Bruce",
    "allowed_actions": [
      "每日按冻结检索式查询 PubMed 并生成候选条目",
      "按冻结字段模板做格式校验",
      "独立复核纳入资格、数据提取、偏倚风险",
      "在版本化证据表中合并已通过全部检查的条目（可回滚）",
      "按冻结SAP复算荟萃分析并起草结论/推荐变更提议",
      "暂停合并或暂停发布并升级"
    ],
    "forbidden_actions": [
      "修改纳入/排除标准、检索式、SAP、GRADE规则或推荐阈值",
      "未经 Bruce 签字改写论文结论段落",
      "未经 Bruce 签字更新网站推荐意见",
      "删除或改写已合并条目的历史版本",
      "执行者节点修改验证、审计、反指标或锚点"
    ]
  },
  "frozen_rules": [
    "预注册方案（PICO、纳入/排除标准、检索式、SAP、GRADE与推荐阈值）冻结；只能由 Bruce 经 protocol_gate 修订并留版本记录",
    "格式齐全只是进入核查的前置条件，不能单独触发合并",
    "合并需同时满足：格式校验通过 + 独立资格/提取核查通过 + 反指标未亮红灯（撤稿、重复人群、预印本未同行评审）",
    "结论段落与网站推荐任何变动必须经独立复算 + Bruce 签字；网站与论文同一版本号同步发布",
    "Agent A/B 与验证、审计节点使用不同 owner、不同上下文、不同数据入口",
    "证据表、结论、网站均版本化，任何发布可一键回滚到上一签字版本"
  ],
  "approval": {
    "status": "pending"
  },
  "budget": {
    "max_agents": 11,
    "max_concurrency": 3,
    "max_retries": 2,
    "max_cost_units": 60
  },
  "failure_policy": {
    "failed": "当日增量全部留在暂存区不合并，结论与网站保持上一签字版本，生成失败报告交 Bruce",
    "blocked": "锚点过期、全文不可得或核查分歧未解时，条目标记 pending，不进入合并分析，升级到仲裁/Bruce",
    "budget_exhausted": "停止当日处理，保留暂存队列与已完成核查记录，次日从断点继续",
    "rollback": "发现已发布结论错误（撤稿、提取错误）时立即回滚网站到上一签字版本并通知 Bruce"
  },
  "stop_handoff": {
    "owner": "Bruce",
    "conditions": [
      "completed：结论/推荐变更经独立复算和 Bruce 签字后同步发布，或当日无需变更且全部候选已有核查结论",
      "blocked：锚点过期或核查分歧未经仲裁",
      "failed：复算失败、发布失败或发现已发布内容错误并已回滚",
      "budget_exhausted：当日预算耗尽，队列保留"
    ],
    "artifact": "handoff.md（当日增量清单、核查与仲裁记录、复算报告、签字/回滚记录、未决事项）"
  },
  "execution_contract": {
    "external_execution": false
  },
  "governance": {
    "arbitration": {
      "owner": "Bruce（可指定方法学合作者代理日常分歧，结论层面仍归 Bruce）",
      "priority_policy": "患者安全与结论正确性 > 方案一致性（纳入/提取准确、撤稿/重复排除） > 检索召回 > 更新及时性 > 处理吞吐量"
    },
    "goal_change": "human_approval",
    "approval_required": [
      "Root-goal change",
      "Anchor change",
      "Permission expansion",
      "纳入标准/检索式/SAP/GRADE阈值修订",
      "论文结论段落变更",
      "网站推荐意见变更"
    ]
  },
  "verification": {
    "independence_statement": "资格与提取核查由不同 owner 的独立审阅者（另一模型实例，fresh 上下文 + 人工方法学审阅者抽检）直接从 PubMed 原始记录和全文重新判定，不读取 Agent A 的判定理由；结论复算由独立统计审阅者用冻结SAP和冻结复算脚本完成；召回审计使用 Agent A 从未接触的已知研究基准集与试验注册库。",
    "checks": [
      {
        "verifier_node": "eligibility_verify",
        "check": "纳入资格、数据提取、偏倚风险与原始记录/全文一致；双人一致率≥95%"
      },
      {
        "verifier_node": "format_check",
        "check": "字段完整性与取值格式（仅作前置条件）"
      },
      {
        "verifier_node": "synthesis_verify",
        "check": "按冻结SAP独立复算效应量与GRADE，结论措辞与结果方向/确定性一致"
      }
    ]
  },
  "external_inputs": [
    "PubMed 每日新增检索结果",
    "全文PDF"
  ],
  "anchors": [
