{
  "schema_version": "1.1",
  "title": "规培住院医师题库与出科考试控制架构",
  "mode": "graph",
  "state": "designed",
  "root_goal": {
    "statement": "出科考试能有效、公平地判定规培住院医师是否达到本科室出科能力要求；练习题库帮助学员在出科前补上薄弱点。平均正确率70%只是练习库的代理指标，不是根结果。",
    "human_owner": "Bruce（题库系统负责人；出科考试签发由科室教学主任/考核小组承担）",
    "observable_success": "每月出科试卷：100%题目经两名带教专家审核且答案唯一、符合现行指南；蓝图覆盖率≥95%；考试题来自学员练习时未见过的封存题池；按Angoff标准设定合格线并由考核小组签字；出科成绩与独立临床能力评估（Mini-CEX/DOPS/带教评分）方向一致，每季度复核",
    "out_of_scope": [
      "让Agent B把出科考试平均正确率调到70%（考试按标准参照定合格线，不按正态目标调难度）",
      "Agent直接发布或修改出科试卷",
      "Agent修改合格线、考核大纲蓝图或锚题集",
      "用题库成绩替代结业考核或临床能力评价"
    ],
    "metrics": [
      "出科考试判定与独立临床能力评估一致率",
      "蓝图覆盖率",
      "题目区分度",
      "练习库平均正确率",
      "锚题正确率",
      "每周新题数"
    ]
  },
  "classification_rationale": "不是单回路：A的出题量、B的70%正确率是两个可被刷的代理指标，会与考试效度冲突（B最省事的办法是把难题改简单、改掉区分度、或让学员在练习里先见到考题）；调整后的题直接进入高利害的出科考试，需要独立审题、反指标、审计、仲裁和人工签发门；B不能改自己的裁判（锚题、合格线、蓝图）。故用多回路图，A和B节点内部各是一个有界回路（graph_plus_loop 亦可，这里按 graph 交付）。",
  "permissions": {
    "human_owner": "Bruce",
    "allowed_actions": [
      "A每周按蓝图生成练习单选题草稿",
      "B调整练习库题目的难度标签、出题顺序和推送频率",
      "B对题干/选项提出修改建议（需重新走审题）",
      "从封存题池按蓝图组卷草稿",
      "计算题目统计量与审计报告"
    ],
    "forbidden_actions": [
      "Agent直接把题目写入出科试卷",
      "B直接改写题干、答案或选项并绕过审题",
      "修改合格线、蓝图、锚题集或封存题池",
      "把练习库题目原样放入出科考试",
      "删除或隐藏学员作答原始记录",
      "以平均正确率70%作为出科试卷组卷目标"
    ]
  },
  "frozen_rules": [
    "规培细则与本科室出科考核大纲蓝图（只有考核小组可改，Bruce批准）",
    "锚题集（每月固定嵌入练习库，B不可改不可调换）",
    "Angoff合格线流程与合格线",
    "封存考试题池与练习库物理隔离",
    "学员作答原始日志只读、追加写",
    "任何进入出科试卷的题必须经人工门签字"
  ],
  "approval": {
    "status": "pending"
  },
  "budget": {
    "max_agents": 8,
    "max_concurrency": 2,
    "max_retries": 2,
    "max_cost_units": 40
  },
  "failure_policy": {
    "failed": "本月试卷未通过审题/统计/签发：沿用上月已签发的备用卷，问题题目退回A或下线",
    "blocked": "锚题缺失、作答日志异常或审题专家缺席：B冻结在上一版参数，停止向考试池推荐，升级Bruce",
    "budget_exhausted": "停止生成新题，保留现有已审练习库，提交交接说明给Bruce"
  },
  "stop_handoff": {
    "owner": "Bruce",
    "conditions": [
      "completed：试卷经考核小组签字发布且审计无红旗",
      "failed：两轮修订后仍有题目不通过审题或区分度<0.2",
      "blocked：锚题/原始日志/专家审核任一缺失",
      "budget_exhausted：本月预算用完"
    ],
    "artifact": "handoff.md（本月试卷状态、问题题目清单、审计结论、待批准提案）"
  },
  "execution_contract": {
    "external_execution": false
  },
  "governance": {
    "arbitration": {
      "owner": "科室考核小组组长（教学主任），Bruce知情",
      "priority_policy": "患者安全与内容正确性 > 考试效度（蓝图覆盖、区分度、与临床评估一致）> 考试公平与防泄题 > 练习库正确率接近70% > 每周新题数"
    },
    "goal_change": "human_approval",
    "approval_required": [
      "根目标或70%目标值变更",
      "锚题集、蓝图、合格线变更",
      "Agent权限扩大（如允许改写题干）",
      "封存题池规则变更"
    ]
  },
  "verification": {
    "independence_statement": "审题由两名未参与出题的带教专家对照现行指南与蓝图完成（评估者独立）；反指标回路读取学员作答原始日志和锚题表现，而不是B的调参报告（数据来源独立）；审计用独立临床能力评估（Mini-CEX/DOPS/带教评分）这一A、B都无法生成或改写的外部来源。",
    "checks": [
      {
        "name": "内容正确性与答案唯一",
        "verifier_node": "item_review"
      }
    ]
  },
  "external_inputs": [
