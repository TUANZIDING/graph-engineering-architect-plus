{
  "schema_version": "1.1",
  "title": "规培题库：出题 Agent A + 难度自适应 Agent B + 出科考试的控制架构",
  "mode": "graph_plus_loop",
  "state": "designed",
  "root_goal": {
    "statement": "让规培住院医师通过练习真正掌握轮转科室的核心能力，同时让出科考试对这一能力的判断准确、公平、不泄题。练习正确率 70% 只是练习区的难度代理指标，不是根目标；考试题的难度由标准设定和独立校准决定，不由练习区的 70% 目标倒推。",
    "human_owner": "Bruce（题库系统负责人）；出科考试签发权在专业基地教学主任/考试小组",
    "observable_success": "(1) 进入出科考试的每道题都有临床专家审核记录（答案唯一正确、依据现行指南、对应大纲条目）；(2) 考试题来自独立监考校准样本的心理测量合格（区分度 D≥0.2 或点二列相关≥0.2，无负区分度题），且未在练习区以原题或近似变体曝光；(3) 每份试卷覆盖出科大纲蓝图规定的模块比例；(4) 每月审计中考试成绩与带教医师工作场所评价（Mini-CEX/DOPS）方向一致、无系统性偏离；(5) 练习区平均正确率在 60–80% 区间内，且不是靠降低区分度或删除难点题达到的。",
    "out_of_scope": [
      "Agent B 直接修改或替换出科考试题目",
      "用练习区正确率决定考试难度或及格线",
      "自动发布考试成绩、决定学员出科是否通过",
      "修改国家规培内容与标准或本院出科考核大纲"
    ],
    "metrics": [
      "练习区平均正确率",
      "题目区分度",
      "大纲蓝图覆盖率",
      "专家审核通过率",
      "考试题曝光率",
      "考试成绩与工作场所评价一致性"
    ]
  },
  "classification_rationale": "不是单回路：Agent B 追的 70% 正确率极易被刷（把题改简单、删难点、反复练同一题让学员背答案都能达标），必须配独立的反指标回路和现实锚点；Agent A 出题的医学正确性需要和出题者无关的临床专家否决；练习（形成性）和出科考试（终结性、高风险）是两个目标冲突的回路，原方案让 B 调整后的题直接入考，等于让优化者改写自己的裁判，必须切开并在考试前加人工签发门；70% 目标本身和蓝图需要更慢的治理回路由人审定。",
  "permissions": {
    "human_owner": "Bruce",
    "allowed_actions": [
      "Agent A 每周在练习区草稿库生成单选题草稿",
      "Agent B 在审核通过的练习题池内调整出题顺序、组卷难度配比和推送策略",
      "Agent B 提议改写题干/选项（改写后视为新题，必须重新专家审核）",
      "反指标回路读取练习作答日志和独立校准样本统计",
      "考试组卷节点从合格且未曝光的考试题池生成候选试卷"
    ],
    "forbidden_actions": [
      "任何 Agent 把题目直接写入出科考试题池或试卷",
      "Agent A/B 修改出科大纲蓝图、专家审核标准、心理测量阈值或 70% 目标",
      "Agent B 删除或停推难点/低正确率题目以抬高平均正确率",
      "把练习区曝光过的原题或近似变体放进出科考试",
      "未经考试小组签发发布试卷或成绩"
    ]
  },
  "frozen_rules": [
    "练习题池与出科考试题池物理隔离；练习区任何题目（含 B 改写版）不得直接进入考试",
    "考试题必须：专家审核通过 + 独立监考校准样本心理测量合格 + 未在练习区曝光 + 蓝图覆盖达标，四项缺一不可",
    "出科考试难度与及格线用标准设定（如 Angoff）由考试小组确定，不由练习区正确率目标倒推",
    "B 改写过题干或选项的题按新题处理，重新走专家审核",
    "蓝图、审核标准、心理测量阈值、70% 目标、权限的修改只能由 Agent 提议，经人工门批准后生效",
    "冲突时优先级：医学正确性与患者安全 > 考核效度与公平（蓝图覆盖、区分度、不泄题） > 学习效果 > 练习正确率接近 70% > 出题数量与更新速度"
  ],
  "approval": {
    "status": "pending"
  },
  "budget": {
    "max_agents": 8,
    "max_concurrency": 3,
    "max_retries": 2,
    "max_cost_units": 40
  },
  "failure_policy": {
    "failed": "某批题目连续 3 轮专家审核不通过，停用该批次，A 的出题提示与依据交 Bruce 复查",
    "blocked": "缺少独立校准样本、专家审核或蓝图版本过期时，考试组卷暂停，沿用上一期已签发题池，不用练习区题目补位",
    "budget_exhausted": "保留已审核题目与日志，停止新增，交 Bruce 决定是否追加预算或降低出题频率"
  },
  "stop_handoff": {
