{
  "schema_version": "1.2",
  "title": "急诊脓毒症预警误报治理：Agent 只提议、独立结局锚定、人工批准改阈值",
  "mode": "graph_plus_loop",
  "state": "designed",
  "root_goal": {
    "statement": "在不增加漏诊/延迟识别脓毒症的前提下，降低急诊脓毒症预警的无效报警负担（用户期望：护士标记误报减半）。被改善的真实结果是“护士收到的报警中真正需要行动的比例上升”，而不是“报警变少”本身。",
    "human_owner": "Bruce（项目发起人）；生产阈值变更的临床安全签字人为急诊科主任 + 医院脓毒症质控小组（含护理部、信息科）",
    "observable_success": "连续≥8周、在训练窗口之后的时间留出期内：(1) 每100例急诊就诊中被护士标记为误报的报警数较基线下降≥50%；(2) 经独立医师按 Sepsis-3 回顾裁定的样本中，模型对脓毒症的敏感度非劣于基线（建议界值：95%CI 下限不低于基线−5个百分点，由质控小组最终确认）；(3) 无报警的脓毒症病例数、抗生素启动时间、48小时内转ICU、30天死亡率均不劣于基线；(4) 预先指定亚组无明显恶化。四项同时满足才算成功；只满足(1)不算。",
    "out_of_scope": [
      "Agent 自动修改生产环境中的预警阈值或模型参数",
      "以护士误报标签作为唯一真值来训练或调阈值",
      "改动报警系统以外的临床流程、医嘱或分诊规则",
      "向院外传输可识别患者身份的数据",
      "对单个患者手动屏蔽报警"
    ],
    "metrics": [
      "nurse_flagged_false_alarm_rate",
      "adjudicated_sensitivity",
      "adjudicated_ppv",
      "missed_sepsis_count",
      "time_to_antibiotics",
      "icu_transfer_48h",
      "mortality_30d"
    ],
    "domain": [
      "clinical_protocol",
      "ml_model"
    ]
  },
  "classification_rationale": "不是单回路：用户提出的“按护士误报标签每周自动调高阈值”本身就是一个会钻指标空子的回路——提高阈值几乎必然减少误报，但同时降低敏感度，而漏报的脓毒症不会产生报警、也就不会被护士标记，这个回路看不见自己造成的伤害。误报标签还混杂了“非脓毒症”与“是脓毒症但已在处理/重复/不需行动”，并受报警疲劳影响。因此需要：独立于标签的真实结局锚点（医师回顾裁定 + EHR 硬结局，覆盖未报警病例）、漏诊反指标、标签有效性审计、慢节奏治理与人工门。执行回路每周分析但只能提议，阈值变更最多按月、经人工批准、可回滚。",
  "permissions": {
    "human_owner": "Bruce（发起）；急诊科主任 + 脓毒症质控小组（批准）",
    "allowed_actions": [
      "只读获取上周报警日志、风险评分日志与护士误报标签",
      "按误报原因分类（非感染/已在处理/重复报警/数据错误等）",
      "在设计窗口内模拟候选阈值、分层阈值或去重/抑制规则并生成提议包",
      "生成周报与给质控小组的变更申请草稿"
    ],
    "forbidden_actions": [
      "写入或修改生产预警阈值、模型权重或报警配置",
      "修改护士标签、医师裁定结果、EHR 结局提取口径",
      "修改安全下限、亚组清单、留出期定义或成功标准",
      "读取时间留出期的裁定结果用于选择阈值",
      "向院外传输可识别患者数据"
    ]
  },
  "frozen_rules": [
    "真值来源是独立医师按 Sepsis-3 的回顾裁定与 EHR 硬结局，不是护士误报标签；Agent 不得改写、筛选或延迟这些数据。",
    "安全下限（敏感度非劣界值、漏诊脓毒性休克病例零容忍复核、抗生素时间与30天死亡率不劣）与预先指定亚组只能由质控小组经人工门修改。",
    "候选阈值必须在 Agent 选阈值时未见过的后续时间段上验证，并预留≥30天结局成熟期后再判定死亡率类结局。",
    "生产阈值变更：单次只改一处、每月最多一次、每次变更后最短观察窗4周、必须有版本号与一键回滚。",
    "“误报减半”是目标而非硬约束；它与安全下限冲突时，安全下限优先，目标交治理回路与人工门重审。"
  ],
  "approval": {
    "status": "pending"
  },
  "budget": {
    "max_agents": 6,
    "max_concurrency": 3,
    "max_retries": 1,
    "max_cost_units": 20
  },
  "failure_policy": {
    "failed": "候选阈值在留出期未通过敏感度/亚组/校准检查：不上线，记录原因，下一个周期改为尝试非阈值方案（去重、已在治疗者抑制、分层阈值）。",
    "blocked": "裁定样本量不足、标签审计显示“误报”标签与裁定一致率过低、或锚点未经复核：停止提议任何阈值变更，交质控小组。",
    "budget_exhausted": "连续3个月提议均被否决或未达目标：停止自动提议，交治理回路重审目标（可能需要模型重新校准或更换方案，而非继续调阈值）。",
    "rollback": "上线后漏诊反指标或亚组恶化触发：立即回滚到上一版本配置并上报人工门。"
  },
  "stop_handoff": {
    "owner": "Bruce + 急诊科主任",
    "conditions": [
      "completed：成功标准四项在≥8周留出期同时满足，质控小组签字",
      "failed：安全下限被触发并已回滚",
      "blocked：真值锚点缺失/过期或标签不可靠",
      "budget_exhausted：连续3个月无可批准方案"
    ],
    "artifact": "handoff.md（当前生效阈值版本、变更记录、裁定结果摘要、未决风险）"
  },
  "execution_contract": {
    "external_execution": false
  },
  "governance": {
