{
  "schema_version": "1.2",
  "title": "急诊脓毒症预警误报治理：Agent提案 + 结局锚定验证 + 人工批准阈值变更",
  "mode": "graph_plus_loop",
  "state": "designed",
  "root_goal": {
    "statement": "在不降低脓毒症检出敏感度、不延迟报警的前提下，减少急诊脓毒症预警中的不可行动报警（护士报警负担），目标为误报率较基线降低约50%（此目标本身由委员会季度复审）",
    "human_owner": "Bruce（急诊外科主治医师），最终由脓毒症管理委员会签字",
    "observable_success": "影子运行及上线后，按盲法结局裁定：可行动报警率/PPV上升、每班报警数下降且误报降幅接近50%；同时敏感度不低于基线减预设非劣效界值、漏诊/晚诊脓毒症（含转ICU、死亡）不超过硬上限、报警提前时间中位数不缩短超过预设值、各预设亚组无明显下降",
    "out_of_scope": [
      "Agent每周自动改生产阈值（用户原方案；改为只提案、人工批准）",
      "重训或更换预警模型本身",
      "把护士误报标签当作真实结局",
      "护士排班与人力配置",
      "实时/每日自动调参"
    ],
    "metrics": [
      "non_actionable_alert_rate",
      "sensitivity_vs_adjudicated_sepsis",
      "missed_or_delayed_sepsis_count",
      "alert_lead_time",
      "ppv",
      "calibration",
      "subgroup_sensitivity"
    ],
    "domain": [
      "clinical_protocol",
      "ml_model"
    ]
  },
  "classification_rationale": "用户原方案是单回路：以护士“误报”标签为唯一信号、每周单向调高阈值。该信号可被廉价刷低（阈值越高误报越少，但漏诊也越多），标签非真实结局（报警时看似误报的病例数小时后可能确诊），且阈值变更是高风险临床变更。因此需要：独立结局锚点、漏诊反指标、标签效度审计、漂移审计、仲裁与人工批准门；内部的提案-验证是有界回路，故为 graph_plus_loop。",
  "permissions": {
    "human_owner": "Bruce + 脓毒症管理委员会",
    "allowed_actions": [
      "读取报警日志与护士误报标签",
      "读取结局裁定数据集(只读)",
      "在历史/留出数据上回放模拟",
      "生成配置调整提案与报告",
      "向人工门提交提案"
    ],
    "forbidden_actions": [
      "直接修改生产预警阈值或抑制规则",
      "修改结局裁定数据、敏感度下限、非劣效界值或漏诊硬上限",
      "修改验证者/审计者的口径或亚组清单",
      "跳过影子模式上线",
      "在单次或季度累计上限之外调整阈值"
    ]
  },
  "frozen_rules": [
    "结局锚点由质控科独立提取，Agent只读不可写",
    "敏感度下限、非劣效界值、漏诊硬上限、预设亚组清单只能经委员会人工门修改",
    "任何生产配置变更须委员会签字并先影子运行≥2周",
    "单次阈值调整与季度累计调整有上限，防止每周单向上调棘轮",
    "漏诊/晚诊超限立即回滚到基线配置",
    "护士误报标签只作线索，不作验收证据"
  ],
  "approval": {
    "status": "pending"
  },
  "budget": {
    "max_agents": 8,
    "max_concurrency": 3,
    "max_retries": 2,
    "max_cost_units": 20
  },
  "failure_policy": {
    "failed": "验证或反指标否决：提案作废，生产配置保持不变，原因写入周报",
    "blocked": "结局锚点缺失/过期或标签效度不足：暂停提案，升级委员会",
    "budget_exhausted": "3轮提案仍未通过：本周不调整，交委员会讨论非阈值手段（报警合并、已治疗抑制、数据质控）",
    "rollback": "上线后漏诊超限：一键回滚基线并上报"
  },
  "stop_handoff": {
    "owner": "Bruce",
    "conditions": [
      "completed：影子+上线观察期达成可观察成功标准且安全指标通过",
      "failed：连续两个提案因安全否决",
      "blocked：结局锚点不可得或标签效度持续不足",
      "budget_exhausted：迭代/成本预算用尽",
      "rolled_back：上线后漏诊超限已回滚"
    ],
    "artifact": "handoff.md"
  },
  "execution_contract": {
    "external_execution": false
  },
  "governance": {
    "arbitration": {
      "owner": "急诊科主任（委员会主席）",
      "priority_policy": "患者安全(漏诊/延迟) > 标签效度 > 校准/亚组 > 报警负担；误报降幅不能抵消任何安全否决"
    },
    "goal_change": "human_approval",
    "approval_required": [
      "根目标(误报降一半)修改",
      "锚点/安全边界修改",
      "权限扩展",
      "任何生产配置变更"
    ]
  },
  "verification": {
    "independence_statement": "验证者为独立统计人员，使用质控科从EHR独立提取的结局裁定与提案窗口之后的时间留出数据；评估者与数据来源均不同于Agent所用的护士误报标签",
    "checks": [
      {
        "verifier_node": "safety_verifier",
        "checks": "threshold_proposer"
      }
    ]
  },
  "external_inputs": [
    "护士误报标签",
    "报警日志",
    "EHR结局原始记录",
    "盲法病历裁定表",
    "委员会批准记录",
    "时间留出报警日志",
    "上线后报警日志"
  ],
