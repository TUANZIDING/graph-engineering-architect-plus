    {
      "node_id": "anchor_numeric_reference",
      "source": "外部认证数值参考集（NIST StRD 认证值 + Bruce 预先固定的独立参考实现对照表，存放于 Bruce 控制的只读位置）",
      "evidence_form": "参考数据集 + 认证结果 + 允许误差（冻结文件的哈希）",
      "owner": "Bruce",
      "freshness_rule": "随每次发布候选重新比对；参考集本身只在 Bruce 批准时更新，更新记录写入治理日志；每 180 天由 Bruce 复核参考集哈希与参考实现版本",
      "frozen": true,
      "max_age_days": 180,
      "last_confirmed": "2026-11-15",
      "last_confirmed_note": "设计基线日期；上线前 Bruce 核对参考集哈希后改为实际确认日",
      "revalidation_gate": "maintainer_release_gate"
    }
  ],
  "domain_audits": [
