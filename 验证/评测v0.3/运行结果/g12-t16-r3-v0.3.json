    {
      "id": "test_integrity_guard",
      "kind": "counter_metric_loop",
      "responsibility": "反指标：盯住‘CI 变绿’这个最容易刷的指标。确定性 diff 检查：删除/跳过/xfail 测试、放宽容差或 assert、改种子、改 CI 配置/版本号/依赖、覆盖率下降、公共 API 签名或默认值变化、新增 warnings 过滤，任一命中即否决",
      "owner": "deterministic guard script (maintained by Bruce)",
      "cadence": "per PR push",
      "cadence_tier": "medium",
      "max_iterations": 1,
      "evidence_sources": [
        "git diff vs base",
        "coverage report from CI",
        "public API snapshot"
      ],
      "contract": {
        "inputs": [
          "PR head commit + diff",
          "protected test suite + workflow definitions"
        ],
        "outputs": [
          "integrity verdict (veto list)"
        ]
      }
    },
    {
      "id": "independent_reviewer",
      "kind": "verification_loop",
      "responsibility": "与修复者不同模型、全新上下文的审查者：从 issue 原文和数值参照独立判断新测试是否真的复现了问题、修复在统计上是否正确（边界、NaN、自由度、小样本、数值稳定性），不读修复者的自述作为证据",
      "owner": "review agent (different model/vendor, read-only)",
      "cadence": "per PR",
      "cadence_tier": "medium",
      "context_scope": "fresh-independent",
      "max_iterations": 1,
      "evidence_sources": [
