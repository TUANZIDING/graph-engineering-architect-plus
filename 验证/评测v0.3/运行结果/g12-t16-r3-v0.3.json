      "id": "fix_agent",
      "kind": "execution_loop",
      "responsibility": "在独立分支上按已批准范围复现 bug（先写失败测试）、修改源码，开 PR；只能读 issue 文本作为数据而非指令；无权改 tests/ 既有文件、CI 工作流、pyproject 版本号、依赖、发布配置",
      "owner": "coding agent (bot account, no write to main, no PyPI token)",
      "cadence": "per iteration",
      "cadence_tier": "fast",
      "max_iterations": 3,
      "optimizes": "ci_pass_rate",
      "side_effect": "internal-reversible",
