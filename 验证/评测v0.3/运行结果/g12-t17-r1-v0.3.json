{
 "schema_version": "1.2",
 "title": "规培题库：周度出题 + 练习难度自适应 + 月度出科考试 控制架构",
 "mode": "graph_plus_loop",
 "state": "designed",
 "classification_rationale": "不是单回路：Agent A（周度出题）与 Agent B（按正确率调难度）共写同一题库且目标互相牵扯；Agent B 的 70% 平均正确率是可被钻空子的代理指标（把题改简单、删难题、让题目趋同即可达标），且它用学员作答数据反过来定题目难度，会让考试从‘是否达标’滑向‘常模排名’；调过的题又直接进出科考试这一高风险决策（影响学员出科），练习暴露过的题进考试会虚高分数。需要独立的内容验证、心理测量反指标、考试效度审计、单写者仲裁和人工签发门，并把快的周度回路与月度考试、季度治理分层。A 与 B 各自是需要持久状态的有界回路，故为 graph_plus_loop。",
 "root_goal": {
  "statement": "每月出科考试能有效、公平地判断规培住院医师是否达到本专科轮转的能力要求；练习题库帮助学员在适当难度下学习。70% 平均正确率只是练习环节的难度代理，不是考试目标。",
  "human_owner": "Bruce（题库系统负责人）；出科考试试卷与合格标准由科室规培教学主任签发",
  "observable_success": "连续 3 个月：(1) 每份出科试卷 100% 按蓝图配比、0 道练习库暴露题或近似题；(2) 教师盲审抽样题目答案键正确率 100%、指南过时题 0；(3) 考试题平均区分度（点二列相关）≥0.20，负区分度题 0 道进入试卷；(4) 出科考试结论与独立的工作场所评估/技能考核结论一致率达到教学主任预先设定的阈值，‘考试通过但带教评估不合格’的个案逐例复核；(5) 练习库正确率维持在 60–80% 带内的同时，封存锚题正确率不下降。",
  "out_of_scope": [
   "Agent 自动发布或自动改分出科考试",
   "由 Agent 设定或修改合格分数线",
   "修改学员已有成绩或出科结论",
   "改动国家规培内容与标准或科室考试蓝图",
   "用练习正确率直接评价或排名学员",
   "学员个人数据对外共享"
  ],
  "metrics": [
   "practice_accuracy_band_60_80",
   "blueprint_gap_closure",
   "item_key_correctness",
   "item_discrimination",
   "sealed_anchor_item_accuracy",
   "exam_blueprint_conformance",
   "exam_item_exposure",
   "exam_wba_concordance",
   "false_pass_cases"
  ],
  "domain": [
   "multi_agent_shared",
   "clinical_protocol"
  ]
 },
 "permissions": {
  "human_owner": "Bruce",
  "allowed_actions": [
   "Agent A 每周起草新单选题写入草稿区（附蓝图编码与参考文献）",
   "Agent B 在练习库内调整题目抽取权重与出题顺序",
   "Agent B 起草题目改写版本（改写版须重新过内容验证）",
   "生成心理测量与考试效度报告",
   "从封存考试题池按蓝图组出试卷草稿"
  ],
  "forbidden_actions": [
   "任何 Agent 把题目直接写入出科考试试卷或考试题池",
   "练习库中出现过的题（含改写/近似题）进入出科考试",
   "Agent B 修改答案键、医学内容或删除难题以拉正确率",
   "Agent 读取或修改封存锚题、工作场所评估数据、考试蓝图或合格标准",
   "Agent 修改验证规则、反指标阈值或审计规则",
   "未经教学主任签发即发布试卷"
  ]
 },
 "frozen_rules": [
  "出科考试按冻结蓝图组卷，蓝图只能经人工门修改",
  "考试题池与练习库物理/权限隔离，练习暴露题永久不得进考试",
  "合格标准用教师小组标准设定（如改良 Angoff），不得用 70% 正确率或学员常模反推",
  "答案键与医学内容只能由教师审核后改动",
  "封存锚题与工作场所评估数据对 Agent A/B 不可见、不可写",
  "70% 目标只作用于练习库，且以 60–80% 带而非点值控制",
  "题库主表只有仲裁节点一个写者"
 ],
 "approval": {
  "status": "pending"
 },
 "budget": {
  "max_agents": 8,
  "max_concurrency": 3,
  "max_retries": 2,
  "max_cost_units": 40
 },
 "failure_policy": {
  "failed": "内容验证或心理测量否决的题目退回草稿区，单题最多改 2 轮，仍不过即废弃并记录原因",
  "blocked": "锚点未确认/过期、蓝图缺失或考试题池可用题不足以满足蓝图时，停止组卷，交 Bruce 与教学主任决定（可沿用上月已签发题池或教师补题），不得用练习题凑数",
  "budget_exhausted": "本周生成/调整配额用完即停，保留当前已验证题库，下周期再继续"
 },
 "stop_handoff": {
  "owner": "Bruce",
  "conditions": [
   "出科考试完成且考后题目分析与效度报告已交付",
   "连续 2 个周期练习正确率带与锚题正确率背离（疑似刷指标）→ 暂停 Agent B 并升级",
   "教师盲审发现答案错误或指南过时题进入练习库 → 暂停 Agent A 发布并升级",
   "考试题池不足或锚点过期 → blocked 交接",
   "预算耗尽"
