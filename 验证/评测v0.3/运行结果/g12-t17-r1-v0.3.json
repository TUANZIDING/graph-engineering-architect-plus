  ]
 },
 "verification": {
  "independence_statement": "内容验证由非出题者的专科带教老师盲做题（先作答后看答案键）并对照现行指南参考清单，加确定性题目规范检查；数据来源是指南与蓝图锚点和老师独立作答，不是 Agent A 的解析。心理测量反指标使用 Agent A/B 不可见的封存锚题；考试效度审计使用教学办独立记录的工作场所评估与技能考核，与题库作答数据来源不同。",
  "checks": [
