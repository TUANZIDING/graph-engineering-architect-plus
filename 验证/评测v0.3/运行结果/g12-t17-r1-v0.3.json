   },
   {
    "verifier_node": "content_verifier",
    "criterion": "Agent B 的改写版本未改变考点、答案键与医学结论",
    "evidence": "原题/改写题对照 + 教师复核",
    "failure_signal": "考点漂移或答案键变化"
   }
  ]
 },
