          "本周推荐提案"
        ]
      },
      "max_iterations": 5,
      "optimizes": "false_alert_rate_confirmed",
      "evidence_sources": [
        "清洗后的周数据集",
        "金标准标签表"
      ],
      "side_effect": "none",
      "writes": [
        "提案报告"
      ],
      "cadence_tier": "medium"
    },
    {
      "id": "missed_sepsis_counter_loop",
