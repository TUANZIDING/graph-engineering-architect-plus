      "owner": "Bruce + 临床委员会",
      "freshness_rule": "仅委员会可修订；每季度复核",
      "frozen": true,
      "max_age_days": 90,
      "last_confirmed": "2026-11-15"
    }
  ],
  "external_inputs": [
