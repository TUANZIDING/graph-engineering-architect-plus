    {
      "id": "anchor_safety_thresholds",
      "kind": "anchor",
      "responsibility": "提供冻结的安全约束与允许调整范围。",
      "owner": "Bruce + 临床委员会",
      "contract": {
        "inputs": [
          "委员会冻结的安全约束文件"
        ],
        "outputs": [
          "安全约束"
        ]
      },
      "side_effect": "none",
      "cadence_tier": "governance"
    },
    {
      "id": "threshold_proposal_loop",
      "kind": "execution_loop",
      "responsibility": "在历史/离线数据上搜索候选阈值（及分层、去重抑制等非阈值方案），每个候选输出误报下降与灵敏度损失的权衡；只在安全约束内给出最多一个推荐提案，步长不超过上限。",
      "owner": "Agent（提案）",
      "contract": {
        "inputs": [
