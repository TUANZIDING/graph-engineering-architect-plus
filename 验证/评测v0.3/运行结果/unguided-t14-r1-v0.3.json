{
  "schema_version": "1.1",
  "title": "急诊脓毒症预警阈值调优：每周提案循环 + 漏报反指标 + 临床委员会人工门控",
  "mode": "graph_plus_loop",
  "rationale": "用户原方案（Agent 依据护士标记的误报每周自动调高阈值，以“误报减半”为唯一目标）是典型 Goodhart 陷阱：调高阈值必然降低灵敏度，误报减少的同时会增加漏报（真正脓毒症晚识别/未识别），而漏报才是致命伤害；且“护士标记误报”不是金标准（标记时多数患者结局未明，存在警报疲劳偏倚），用它既做优化信号又做验证会形成循环互证。因此不能用单一 loop 或直接自动改阈值：需要图结构把（1）误报数据清洗与结局回溯、（2）阈值候选模拟、（3）独立的漏报/灵敏度反指标循环、（4）基于病历回顾的锚点、（5）临床委员会人工门控、（6）上线后安全监测与自动回滚串起来；每周节奏的提案-评估构成外层循环，故为 graph_plus_loop。Agent 只能提出和模拟，绝不能直接修改生产阈值。",
  "state": "design",
  "root_goal": {
    "statement": "在不增加脓毒症漏报和识别延迟的前提下，降低急诊脓毒症预警系统的误报负担（目标：可执行的误报率下降约50%，但仅在安全约束满足时追求）。",
    "human_owner": "Bruce（急诊科，需联合急诊科主任/脓毒症质控小组/护理部/信息科作为共同责任方）",
    "observable_success": "经临床委员会批准的阈值变更上线后连续≥4周：每100次就诊（或每1000患者时）的经回溯确认误报数较基线下降（目标约50%）；同期经病历回顾确认的脓毒症病例灵敏度不低于基线下限（非劣效界值由委员会事先冻结，如绝对下降≤2个百分点且置信区间下界不越界）；首次预警至抗生素时间、ICU转入、28天死亡率等安全指标无恶化；任一安全指标越界即回滚。",
    "metrics": [
      "false_alert_rate_confirmed",
      "sepsis_sensitivity",
      "missed_sepsis_count",
      "time_to_antibiotics",
      "alert_to_recognition_delay",
      "positive_predictive_value",
      "mortality_28d",
      "nurse_alert_burden"
    ]
  },
  "permissions": {
    "human_owner": "Bruce",
    "allowed_actions": [
      "只读访问去标识化的报警日志、护士误报标记、电子病历结局字段（经信息科/伦理或质控授权）",
      "在离线历史数据上模拟候选阈值并计算误报率、灵敏度、PPV、预警提前时间",
      "生成每周阈值调整提案报告与漏报病例清单",
      "在沙盒/影子模式（silent mode）中运行候选阈值，不触发真实报警",
      "上线后监测指标并在越界时向人工发出回滚请求"
    ],
    "forbidden_actions": [
      "Agent 自主修改生产环境预警阈值或模型参数",
      "仅以误报减少为目标进行优化而不计算漏报/灵敏度",
      "把护士“误报”标记直接当作金标准标签",
      "单次调整幅度超过委员会冻结的步长上限",
      "在委员会批准前把候选阈值推送给真实报警流",
      "修改或删除原始报警日志与护士标记",
      "将可识别患者信息导出到院外或外部模型服务"
    ]
  },
  "frozen_rules": [
    "生产阈值的任何变更必须经脓毒症质控/临床委员会书面批准并按医院医疗器械软件/信息系统变更管理流程执行（如系统为厂商产品，需符合厂商许可的可配置范围与注册证要求）。",
    "灵敏度非劣效界值、安全指标红线、单次调整步长上限和最低观察期在项目开始前冻结，Agent 不得修改。",
    "“误报”的判定以结局回溯（如72小时内是否满足Sepsis-3/医院脓毒症定义、是否开始抗生素/升压药/ICU）为准，护士标记只作为候选信号。",
    "任何调整必须可回滚，保留旧阈值配置及版本号。",
    "漏报病例必须逐例人工复核，不得仅以汇总统计放行。",
    "优先考虑非阈值手段（报警分层、重复报警抑制、确认工作流、特定人群规则排除）与阈值调整并列评估，不默认只调阈值。"
  ],
  "approval": {
    "status": "pending",
    "note": "设计待 Bruce 与急诊科脓毒症质控小组确认；任何上线变更还需委员会逐次批准。"
  },
  "budget": {
    "max_agents": 7,
    "max_concurrency": 3,
    "max_retries": 2,
    "max_cost_units": 200
  },
  "failure_policy": {
    "on_safety_breach": "立即停止提案循环，请求人工回滚到上一批准阈值，并通知 Bruce 与质控小组",
    "on_data_gap": "结局回溯不完整（如72小时结局缺失>10%）时本周不出提案，只报告数据缺口",
    "on_anchor_conflict": "护士标记与病历回顾结论不一致率过高时暂停，交给仲裁与人工复核",
    "on_max_iterations": "达到迭代上限仍未在安全约束内达标，则停止并交接：报告可达到的误报下降幅度与代价，建议改模型/工作流而非继续调阈值",
    "retry": "数据抽取失败可重试≤2次"
  },
  "stop_handoff": {
    "owner": "Bruce",
    "conditions": [
      "任何安全红线越界（灵敏度低于非劣效下界、出现经复核的漏报导致延迟治疗的病例、首剂抗生素时间恶化）",
      "连续两周提案被委员会否决",
      "外层循环达到 max_iterations",
      "结局数据或护士标记质量不足以支持判断",
      "发现阈值已到委员会允许范围边界，继续调高不被允许"
    ],
    "artifact": "交接包：基线与当前指标对比表、每个候选阈值的误报-灵敏度权衡曲线、漏报病例逐例复核记录、阈值变更历史与回滚记录、未解决问题与建议（如工作流改进或模型重训）"
  },
  "execution_contract": {
    "external_execution": false,
    "note": "本设计仅产出架构；Agent 不直接作用于生产报警系统。"
  },
  "anchors": [
    {
      "node_id": "anchor_chart_review",
      "source": "电子病历结局回溯 + 由不知晓阈值方案的急诊/ICU医师按医院脓毒症定义（Sepsis-3）进行的抽样病历复核",
      "evidence_form": "每周抽样报警与未报警病例（含全部疑似漏报）的金标准标签表：是否脓毒症、确诊时间、抗生素时间、结局",
      "owner": "脓毒症质控小组（盲法复核医师）",
      "freshness_rule": "每周更新；用于提案的标签须为报警后≥72小时的结局",
      "frozen": true,
      "max_age_days": 7,
      "last_confirmed": "2026-11-15"
