{
  "schema_version": "1.1",
  "title": "急诊脓毒症预警阈值周度调优——受控提案架构（非自动改阈值）",
  "mode": "graph_plus_loop",
  "rationale": "原请求是让Agent每周依据护士'误报'标记自动调高阈值、以误报减半为目标。这是单指标优化的闭环，直接作用于临床安全参数：调高阈值必然以灵敏度下降（漏报/延迟识别脓毒症）为代价，且'误报'标签本身来自护士主观判断、会受报警疲劳和后续是否确诊影响，不能当作真值。因此不能用单一loop直接改生产阈值：需要图结构把(1)标签审计、(2)以确诊脓毒症结局为锚的反向指标（灵敏度、漏报、抗生素时间）、(3)独立验证、(4)临床委员会人类闸门、(5)停止与回退分开；Agent只做每周分析与提案（loop），生产阈值变更必须人审后由厂商/信息科在受控流程中执行。目标也从'误报减半'改为'在灵敏度不下降的硬约束下降低误报/提高PPV'。",
  "state": "design",
  "root_goal": {
    "statement": "在不降低脓毒症检出灵敏度、不延误治疗的前提下，减少急诊脓毒症预警的无效报警（提高阳性预测值、降低护士报警负担）；每周由Agent产出阈值/规则调整提案，经临床人员批准后才可上线。",
    "human_owner": "Bruce（发起人）；生产阈值变更的最终责任人为急诊科主任/脓毒症质控小组（待Bruce确认具体人）",
    "observable_success": "试运行期（建议≥8–12周）内：经病历复核确诊的脓毒症病例灵敏度不低于基线（非劣效界值预先冻结，如下降≤2个百分点且置信区间下限达标）；报警至抗生素时间、ICU转入、28天死亡等安全指标无恶化；同时每100例就诊报警数或无效报警比例显著下降、PPV上升。'误报减半'仅作为参考目标，不作为可牺牲安全的硬目标。",
    "metrics": [
      "false_alarm_rate",
      "alarm_ppv",
      "alarms_per_100_visits",
      "sepsis_sensitivity",
      "missed_sepsis_count",
      "time_to_antibiotics",
      "icu_transfer_rate",
      "mortality_28d",
      "label_agreement_kappa"
    ]
  },
  "permissions": {
    "human_owner": "Bruce",
    "allowed_actions": [
      "读取上周去标识化的报警日志、护士标记、生命体征/检验数据与出院诊断",
      "抽样病历复核并计算误报率、PPV、灵敏度等指标",
      "在历史数据上离线回放/模拟候选阈值",
      "生成阈值调整提案与风险报告",
      "在影子模式（不触发真实报警）下并行运行候选阈值"
    ],
    "forbidden_actions": [
      "Agent直接修改生产环境预警阈值或规则",
      "以护士'误报'标记作为唯一真值标签",
      "单周内阈值调整幅度超过冻结步长上限",
      "在灵敏度未经结局锚验证时上线任何变更",
      "关闭或静默报警以达成误报指标",
      "向护士或医生展示可识别的个体绩效排名",
      "导出可识别患者数据到院外系统"
    ]
  },
  "frozen_rules": [
    "灵敏度（基于病历复核确诊的脓毒症/Sepsis-3）为硬约束，非劣效界值在试运行前冻结，任何周提案不得突破",
    "生产阈值只能由人类闸门批准后经信息科/厂商变更流程执行，Agent无写权限",
    "单次调整步长与累计调整上限预先冻结（例如单周不超过一个评分档，累计不超过两档），超限需重新立项",
    "'误报'定义必须使用预先写定的操作化标准（如报警后72小时内未满足脓毒症标准且未启动脓毒症处理），护士标记仅作为输入信号并接受审计",
    "评估结局（确诊、抗生素时间、ICU、死亡）由不参与阈值提案的独立复核者判定",
    "出现任何漏报相关的严重不良事件立即暂停并回退到上一已批准阈值",
    "优先考虑不降低灵敏度的替代手段（分层报警、确认窗口、去重/抑制重复报警、合并检验指标），而非单纯上调阈值",
    "该系统若属医疗器械软件，阈值修改需遵守厂商说明与院内医疗器械/信息变更管理及伦理要求"
  ],
  "approval": {
    "status": "pending"
  },
  "budget": {
    "max_agents": 7,
    "max_concurrency": 3,
    "max_retries": 2,
    "max_cost_units": 100
  },
  "failure_policy": "任一验证失败、数据缺失、标签一致性过低（kappa<0.6）或安全指标恶化时：本周不出调整提案，维持当前已批准阈值；严重漏报事件触发立即回退并上报；连续两周无法完成验证则停止循环、交由人类重新评估方案。",
  "stop_handoff": {
    "owner": "Bruce 与急诊科脓毒症质控小组",
    "conditions": [
      "灵敏度低于冻结的非劣效界值或置信区间无法排除劣效",
      "发生与预警漏报/延迟相关的严重不良事件或死亡",
      "护士标签与独立复核一致性过低，标签不可用",
      "累计阈值调整达到冻结上限",
      "连续3周误报指标无改善（提示需改模型或流程而非阈值）",
      "达到试运行期终点，需做总体评估",
      "数据接口、病例组合（如流感季）或系统版本发生重大变化"
    ],
    "artifact": "停止/交接报告：当前及历史阈值、各周提案与批准记录、灵敏度/PPV/误报趋势、安全事件清单、标签审计结果、回退建议"
  },
  "execution_contract": {
    "external_execution": false
  },
  "external_inputs": [
    "weekly_alarm_log",
    "nurse_false_alarm_labels",
    "ehr_vitals_labs",
    "discharge_diagnoses",
    "current_approved_threshold",
    "frozen_noninferiority_margin"
  ],
