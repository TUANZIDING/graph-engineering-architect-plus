    {
      "id": "release_gate",
      "kind": "human_gate",
      "responsibility": "Bruce 批准版本号与发布说明，亲自创建签名 tag，并在受保护 GitHub Environment 中批准发布作业",
      "owner": "Bruce",
      "contract": {
        "inputs": [
          "release_proposal"
        ],
        "outputs": [
          "approved_tag"
        ]
      },
      "side_effect": "high-risk",
      "writes": [
        "git tag"
