      "cadence_tier": "human"
    },
    {
      "id": "publish_pipeline",
      "kind": "execution",
      "responsibility": "由 tag 触发的 CI 作业：构建 sdist/wheel，先发 TestPyPI，干净环境安装冒烟通过后经 Trusted Publishing 发正式 PyPI",
      "owner": "GitHub Actions (protected environment)",
      "contract": {
        "inputs": [
          "approved_tag"
        ],
        "outputs": [
          "published_release"
        ]
      },
      "side_effect": "high-risk",
      "writes": [
        "TestPyPI",
        "PyPI"
      ],
      "cadence_tier": "slow"
    },
    {
      "id": "post_release_monitor",
      "kind": "governance_loop",
      "responsibility": "发布后 14 天：干净环境多 Python 版本安装冒烟、监测新回归 issue；失败则准备回滚 PR 草稿并移交 Bruce 决定 yank；按周复盘自动修复的拒绝率与回归率，必要时收紧 agent-ok 范围",
      "owner": "Bruce",
      "contract": {
        "inputs": [
          "published_release",
          "post_release_regression_count"
        ],
        "outputs": [
          "governance_report",
          "stop_signal"
        ]
      },
      "max_iterations": 14,
      "evidence_sources": [
        "PyPI 安装结果",
        "GitHub issues"
      ],
      "side_effect": "none",
      "cadence_tier": "governance"
    },
    {
      "id": "stop_and_handoff",
      "kind": "stop_handoff",
      "responsibility": "停止当前 issue 处理，保留证据并生成移交报告给 Bruce",
      "owner": "Bruce",
      "contract": {
        "inputs": [
          "stop_signal"
        ],
        "outputs": [
          "handoff_report"
        ]
      },
      "side_effect": "none",
      "cadence_tier": "human"
    }
  ],
