    {
      "id": "release_prep",
      "kind": "synthesis",
      "responsibility": "汇总自上次发布以来已合并修复，起草 CHANGELOG 与建议版本号（依据 API diff 的 SemVer 级别），不创建 tag",
      "owner": "release-agent",
      "contract": {
        "inputs": [
          "merged_commit",
          "api_diff_report"
        ],
        "outputs": [
