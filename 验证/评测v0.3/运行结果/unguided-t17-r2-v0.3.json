      ],
      "side_effect": "internal-reversible",
      "writes": [
        "练习题库(仅入库动作)"
      ]
    },
    {
      "id": "agent_b_adjust",
      "kind": "execution_loop",
      "responsibility": "Agent B 根据去标识化答题统计调整练习题难度，使练习库平均正确率趋向70%；只能改情境复杂度/干扰项，不得改正确答案",
