    {
      "id": "medical_verify",
      "kind": "verification_loop",
      "responsibility": "独立核验每道新题及每道被调整题的医学正确性、唯一正确答案、干扰项合理性，对照指南出处",
      "owner": "独立核验Agent + 带教专家抽检",
      "context_scope": "fresh-independent",
