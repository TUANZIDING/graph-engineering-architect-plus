    {"from": "counter_metrics", "to": "agent_b_difficulty", "relation": "constrains", "artifact": "反指标报告"},
    {"from": "counter_metrics", "to": "agent_b_difficulty", "relation": "vetoes", "artifact": "否决信号"},
    {"from": "counter_metrics", "to": "agent_a_generate", "relation": "observes", "artifact": "覆盖缺口报告"},
    {"from": "bank_curator", "to": "exam_assembler", "relation": "feeds", "artifact": "练习库版本"},
    {"from": "counter_metrics", "to": "exam_assembler", "relation": "feeds", "artifact": "反指标报告"},
